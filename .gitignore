detection/train/_baselines/*.npz
detection/train/_baselines/*.joblib
# Worldcover GeoTIFFs (regenerable from public URL — caught by the *.tif rule above
# but listing here for documentation)
detection/scan/worldcover/
# Encoder ablation embeddings (8-12 MB each, regenerable from encoder_ablation.py)
detection/train/v4_calibrated/ablation/*/embeddings.npz
detection/verify/sheets/
# Keep: detection/verify/build_verification_sheets.py + tags.json (the labels themselves)
detection/spike/out/
# Keep: detection/train/clf*.joblib + detection/train/clf*_metrics.json (small, reproducible artifacts)
