---
// Client-side homeowner form. Local geocoder against franchise polygons,
// PVGIS-derived national yield constant, payback math, LGU friction lookup.
//
// Rate, install cost and yield are NOT hardcoded. They come from
// public/data/tariff.json at build, each carrying the month it was read.
import { clientTariff } from "../data/tariff";
---
<script is:inline type="application/json" id="me-tariff-data" set:html={JSON.stringify(clientTariff)}></script>
<form id="me-form" class="max-w-2xl mx-auto px-6 grid gap-4 mt-4">
  <div class="grid gap-2">
    <label class="text-sm text-ink-700" for="me-address">Your city or municipality</label>
    <input
      id="me-address"
      name="address"
      type="text"
      required
      placeholder="Start typing: Quezon City, Makati, Antipolo, Bacoor, Calamba..."
      class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface"
      autocomplete="off"
      list="franchise-cities"
    />
    <datalist id="franchise-cities"></datalist>
    <p class="text-xs text-ink-500">Picks from the 61 cities and municipalities in Meralco's franchise. Nothing sent to any server; matching runs locally.</p>
  </div>

  <div class="grid gap-2 md:grid-cols-2">
    <div class="grid gap-2">
      <label class="text-sm text-ink-700" for="me-roof">Approximate roof area (m&sup2;)</label>
      <input
        id="me-roof"
        name="roof"
        type="number"
        min="20"
        max="500"
        value="80"
        class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface font-mono tabular-nums"
      />
      <p class="text-xs text-ink-500">Typical PH residential: 60-120 m&sup2;.</p>
    </div>
    <div class="grid gap-2">
      <label class="text-sm text-ink-700" for="me-bill">Monthly Meralco bill (₱)</label>
      <input
        id="me-bill"
        name="bill"
        type="number"
        min="500"
        max="100000"
        value="8000"
        step="100"
        class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface font-mono tabular-nums"
      />
    </div>
  </div>

  <div class="flex items-center justify-between">
    <button type="submit" class="btn">Estimate &rarr;</button>
    <span id="me-status" class="text-xs text-ink-500"></span>
  </div>
</form>

<div id="me-results" class="hidden max-w-3xl mx-auto px-6 mt-10"></div>

<script>
  const DATA_BASE = "/data";
  const BOUNDARIES_URL = "/data/franchise_cities_polygons.geojson";
  const TARIFF = JSON.parse(
    document.getElementById("me-tariff-data")?.textContent ?? "{}",
  ) as {
    ratePhpPerKwh: number;
    rateAsOfLabel: string;
    installPhpPerKwp: number;
    installLow: number;
    installHigh: number;
    installAsOfLabel: string;
    yieldKwhPerKwpPerYear: number;
  };
  const MERALCO_RATE_PHP_PER_KWH = TARIFF.ratePhpPerKwh;
  const RATE_AS_OF = TARIFF.rateAsOfLabel;
  const INSTALL_COST_PHP_PER_KWP = TARIFF.installPhpPerKwp;
  const INSTALL_COST_LOW = TARIFF.installLow;
  const INSTALL_COST_HIGH = TARIFF.installHigh;
  const INSTALL_AS_OF = TARIFF.installAsOfLabel;
  const KWP_PER_M2 = 0.15;
  const SYSTEM_LIFETIME_YEARS = 25;
  const DEGRADATION_PER_YEAR = 0.005;
  // PVGIS-derived national yield for the Philippines, for a fixed-mount, 14%
  // loss, c-Si system anchored at QC lat=14.65. Variation across the franchise
  // is under 5%, so the constant works for a homeowner estimate.
  const PH_KWH_PER_KWP_PER_YEAR = TARIFF.yieldKwhPerKwpPerYear;

  function estimateAnnualKwh(lat: number, _lon: number, kwp: number): number {
    const adjust = 1 + (14.65 - lat) * 0.015;
    return kwp * PH_KWH_PER_KWP_PER_YEAR * adjust;
  }

  let cachedBoundaries: any | null = null;
  async function loadBoundaries() {
    if (cachedBoundaries) return cachedBoundaries;
    try {
      const r = await fetch(BOUNDARIES_URL);
      if (!r.ok) return null;
      cachedBoundaries = await r.json();
      return cachedBoundaries;
    } catch {
      return null;
    }
  }

  function geometryRepresentativePoint(geom: any): [number, number] {
    if (!geom) return [121.05, 14.6];
    const polys = geom.type === "Polygon" ? [geom.coordinates] : geom.coordinates;
    let bestArea = 0;
    let bestCenter: [number, number] = [121.05, 14.6];
    for (const poly of polys) {
      const ring = poly[0];
      if (!ring) continue;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const pt of ring) {
        if (pt[0] < minX) minX = pt[0];
        if (pt[0] > maxX) maxX = pt[0];
        if (pt[1] < minY) minY = pt[1];
        if (pt[1] > maxY) maxY = pt[1];
      }
      const area = (maxX - minX) * (maxY - minY);
      if (area > bestArea) {
        bestArea = area;
        bestCenter = [(minX + maxX) / 2, (minY + maxY) / 2];
      }
    }
    return bestCenter;
  }

  type LocalMatch = {
    lat: number;
    lon: number;
    display_name: string;
    feature: any;
  };

  async function geocodeLocal(q: string): Promise<LocalMatch | null> {
    const fc = await loadBoundaries();
    if (!fc) return null;
    const norm = q.trim().toLowerCase();
    if (!norm) return null;
    const features = fc.features ?? [];
    const matchExact = features.find((f: any) => f.properties.name.toLowerCase() === norm);
    const matchPrefix = features.find((f: any) => f.properties.name.toLowerCase().startsWith(norm));
    const matchContains = features.find((f: any) =>
      f.properties.name.toLowerCase().includes(norm) ||
      norm.includes(f.properties.name.toLowerCase())
    );
    const match = matchExact ?? matchPrefix ?? matchContains;
    if (!match) return null;
    const [lon, lat] = geometryRepresentativePoint(match.geometry);
    return {
      lat, lon,
      display_name: `${match.properties.name}, ${match.properties.province}, Philippines`,
      feature: match,
    };
  }

  async function loadManifest() {
    try {
      const r = await fetch(`${DATA_BASE}/manifest.json`);
      if (!r.ok) return null;
      return await r.json();
    } catch {
      return null;
    }
  }

  async function loadGeoJSON(quarter: string) {
    const r = await fetch(`${DATA_BASE}/solar_map_ph_${quarter}.geojson`);
    if (!r.ok) return null;
    return r.json();
  }

  function pointInPolygon(point: [number, number], polygon: number[][]): boolean {
    const [x, y] = point;
    let inside = false;
    for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
      const xi = polygon[i][0], yi = polygon[i][1];
      const xj = polygon[j][0], yj = polygon[j][1];
      const intersect = yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi;
      if (intersect) inside = !inside;
    }
    return inside;
  }

  function findCityForPoint(fc: any, lat: number, lon: number): any | null {
    for (const f of fc.features ?? []) {
      const geom = f.geometry;
      if (!geom) continue;
      const polys = geom.type === "Polygon" ? [geom.coordinates] : geom.coordinates;
      for (const poly of polys) {
        if (pointInPolygon([lon, lat], poly[0])) return f;
      }
    }
    return null;
  }

  function paybackYears(installCost: number, annualSavings: number): number {
    if (annualSavings <= 0) return Infinity;
    return installCost / annualSavings;
  }

  function lifetimeNpv(annualKwh: number, ratePhpKwh: number, installCost: number): number {
    let total = -installCost;
    let kwh = annualKwh;
    for (let y = 0; y < SYSTEM_LIFETIME_YEARS; y++) {
      total += kwh * ratePhpKwh;
      kwh *= 1 - DEGRADATION_PER_YEAR;
    }
    return total;
  }

  function fmtCurrency(n: number): string {
    return `₱${Math.round(n).toLocaleString()}`;
  }

  function fmtCompact(n: number): string {
    if (n >= 1_000_000) return `₱${(n / 1_000_000).toFixed(2)}M`;
    if (n >= 1000) return `₱${(n / 1000).toFixed(0)}K`;
    return `₱${Math.round(n)}`;
  }

  function bandLabel(score: number | null | undefined): { label: string; tone: string } {
    if (score === null || score === undefined || Number.isNaN(score)) return { label: "no signal", tone: "text-ink-500" };
    if (score >= 1.0) return { label: "strong solar-growth signal vs peer cities", tone: "text-accent-steel font-semibold" };
    if (score >= 0.5) return { label: "above-average signal vs peer cities", tone: "text-accent-steel" };
    if (score > -0.5) return { label: "near the franchise baseline", tone: "text-ink-500" };
    if (score > -1.0) return { label: "below the franchise baseline", tone: "text-accent-coral-dark" };
    return { label: "well below the franchise baseline", tone: "text-accent-coral-dark font-semibold" };
  }

  function renderResults(opts: {
    address: string;
    cityName: string | null;
    cityProps: any;
    cityDetections: any;
    kwp: number;
    annualKwh: number | null;
    monthlyBillPhp: number;
  }) {
    const { address, cityName, cityProps, cityDetections, kwp, annualKwh, monthlyBillPhp } = opts;
    const annualSavings = annualKwh ? annualKwh * MERALCO_RATE_PHP_PER_KWH : 0;
    const installCost = kwp * INSTALL_COST_PHP_PER_KWP;
    const payback = annualKwh ? paybackYears(installCost, annualSavings) : null;
    const npv = annualKwh ? lifetimeNpv(annualKwh, MERALCO_RATE_PHP_PER_KWH, installCost) : null;
    const offsetPct = annualKwh ? Math.min(1, annualKwh / (monthlyBillPhp * 12 / MERALCO_RATE_PHP_PER_KWH)) : 0;

    const permitFee = cityProps?.policy?.lgu_permit_fee_php;
    const permitDays = cityProps?.policy?.lgu_permit_days_p50;
    const permitStatus = cityProps?.policy?.permit_data_status ?? "unverified";
    const cityNHigh = cityDetections?.n_high ?? 0;
    const cityNNew = cityDetections?.n_new_high ?? 0;
    const cityDensityRank = cityDetections?.densityRank ?? 0;
    const cityDensityTotal = cityDetections?.densityTotal ?? 0;
    const cityKwp = cityDetections?.sum_kwp_high ?? 0;

    const root = document.getElementById("me-results")!;
    root.classList.remove("hidden");
    root.innerHTML = `
      <div class="border border-ink-300/40 bg-surface p-6 md:p-8">
        <p class="text-xs uppercase tracking-wider text-ink-500 mb-2">${cityName ?? "your roof"} &middot; ${kwp.toFixed(1)} kWp suggested</p>
        <div class="grid gap-6 md:grid-cols-3 items-baseline mb-3">
          <div>
            <div class="text-xs uppercase tracking-wider text-ink-500 mb-1">payback</div>
            <div class="text-5xl md:text-6xl font-mono font-semibold tabular-nums leading-none text-ink-900">${payback ? payback.toFixed(1) : "-"}</div>
            <div class="text-sm text-ink-500 mt-1">years to break even</div>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-ink-500 mb-1">annual savings</div>
            <div class="text-3xl md:text-4xl font-mono font-semibold tabular-nums leading-none text-ink-900">${annualKwh ? fmtCompact(annualSavings) : "-"}</div>
            <div class="text-sm text-ink-500 mt-1">at ₱${MERALCO_RATE_PHP_PER_KWH.toFixed(2)}/kWh</div>
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-ink-500 mb-1">25-year net</div>
            <div class="text-3xl md:text-4xl font-mono font-semibold tabular-nums leading-none ${npv && npv > 0 ? "text-accent-steel" : "text-ink-900"}">${npv !== null ? fmtCompact(npv) : "-"}</div>
            <div class="text-sm text-ink-500 mt-1">after ${fmtCompact(installCost)} install</div>
          </div>
        </div>
        <p class="text-sm text-ink-700 mt-4 leading-relaxed border-t border-ink-300/30 pt-4">
          You'd cover about <strong>${(offsetPct * 100).toFixed(0)}%</strong> of your current bill with a <strong>${kwp.toFixed(1)} kWp</strong> system on ~${(kwp / KWP_PER_M2).toFixed(0)} m&sup2; of roof. ${cityName && cityNHigh > 0 ? `Our survey already identified <strong>${cityNHigh}</strong> rooftop solar installations in ${cityName}.` : cityName ? `Our survey hasn't identified rooftop solar in ${cityName} yet, but the panels still pay back the same way.` : ""}
        </p>
        <p class="text-xs text-ink-500 mt-3">
          Estimates only. Yield from PVGIS PH average (~${PH_KWH_PER_KWP_PER_YEAR} kWh/kWp/yr), priced at the ${RATE_AS_OF} Meralco residential rate, which Meralco resets monthly. Install cost is ${fmtCurrency(INSTALL_COST_PHP_PER_KWP)}/kWp, mid-range for a ${fmtCurrency(INSTALL_COST_LOW)} to ${fmtCurrency(INSTALL_COST_HIGH)} market as of ${INSTALL_AS_OF}. Talk to a certified installer before deciding.
        </p>
      </div>

      <div class="mt-6 grid gap-3">
        <details class="border border-ink-300/40 bg-paper-alt">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-ink-900 flex justify-between items-center">
            <span>How your city compares <span class="text-ink-500 font-normal">(detection survey)</span></span>
            <span class="font-mono tabular-nums text-xs text-ink-500">${cityNHigh > 0 ? `${cityNHigh} detected` : "n/a"}</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-sm text-ink-700 leading-relaxed">
            <p class="mb-3"><strong>${cityName ?? "this city"}</strong>: our computer-vision survey identified ${cityNHigh > 0 ? `<strong>${cityNHigh}</strong> high-confidence rooftop solar installations${cityNNew > 0 ? ` (${cityNNew} of them not on prior public maps)` : ""}` : "no high-confidence installations yet"}. ${cityDensityRank > 0 ? `${cityName} ranks <strong>#${cityDensityRank}</strong> of ${cityDensityTotal} surveyed cities by detection density (per km²).` : ""}</p>
            <dl class="grid grid-cols-2 gap-y-1.5 gap-x-4 text-xs font-mono tabular-nums">
              <dt class="text-ink-500">Detections (high confidence)</dt><dd class="text-right">${cityNHigh}</dd>
              <dt class="text-ink-500">Newly identified</dt><dd class="text-right">${cityNNew}</dd>
              <dt class="text-ink-500">Aggregate capacity</dt><dd class="text-right">${cityKwp >= 1000 ? (cityKwp / 1000).toFixed(1) + " MWp" : Math.round(cityKwp) + " kWp"}</dd>
            </dl>
            <p class="text-xs text-ink-500 mt-3">Methodology: <a href="/methodology" class="text-accent-steel no-underline">/methodology</a>. <a href="/map?city=${(cityName || "").toLowerCase().replace(/[^a-z0-9]+/g, "-")}" class="text-accent-steel no-underline">See on the map</a>.</p>
          </div>
        </details>

        <details class="border border-ink-300/40 bg-paper-alt">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-ink-900 flex justify-between items-center">
            <span>What your LGU charges to permit it</span>
            <span class="font-mono tabular-nums text-xs text-ink-500">${permitFee !== null && permitFee !== undefined ? fmtCurrency(permitFee) : "unverified"}</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-sm text-ink-700 leading-relaxed">
            <dl class="grid grid-cols-2 gap-y-1.5 gap-x-4 text-xs font-mono tabular-nums mb-3">
              <dt class="text-ink-500">Permit fee</dt><dd class="text-right">${permitFee !== null && permitFee !== undefined ? fmtCurrency(permitFee) : "unverified"}</dd>
              <dt class="text-ink-500">Median approval</dt><dd class="text-right">${permitDays ?? "unverified"}</dd>
              <dt class="text-ink-500">Status</dt><dd class="text-right">${permitStatus}</dd>
            </dl>
            ${permitStatus === "verified"
              ? `<p class="text-xs text-ink-500">From hand-curated LGU friction table. Verify on your LGU's website before filing.</p>`
              : `<p class="text-xs text-ink-500">${cityName}'s permit data is not yet verified in our table. Most LGUs publish their fee schedules online; or <a href="https://github.com/xmpuspus/solar-map-ph" class="text-accent-steel no-underline">contribute a source</a>. April 2026 DOE circular targets a 3-day permit ceiling.</p>`}
          </div>
        </details>

        <details class="border border-ink-300/40 bg-paper-alt">
          <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-ink-900">
            <span>Read this before going "guerrilla"</span>
          </summary>
          <div class="px-5 pb-5 pt-2 text-sm text-ink-700 leading-relaxed">
            <p class="mb-3">"Guerrilla" solar = installed without permits or grid-tied registration. ICSC estimates ~1/3 of rooftop solar in Meralco's franchise is unregistered. The shortcut is real, the cost is real:</p>
            <table class="w-full text-xs mb-3">
              <thead class="text-left text-ink-500">
                <tr><th class="pb-1.5"></th><th class="pb-1.5 font-medium">Registered</th><th class="pb-1.5 font-medium">Guerrilla</th></tr>
              </thead>
              <tbody>
                <tr class="border-t border-ink-300/20"><td class="py-1.5 text-ink-500">Net-metering credits</td><td>Yes (full retail)</td><td>Never</td></tr>
                <tr class="border-t border-ink-300/20"><td class="py-1.5 text-ink-500">Anti-islanding compliance</td><td>utility-verified</td><td>your responsibility</td></tr>
                <tr class="border-t border-ink-300/20"><td class="py-1.5 text-ink-500">Legal exposure</td><td>RA 9513 compliant</td><td>civil + criminal</td></tr>
                <tr class="border-t border-ink-300/20"><td class="py-1.5 text-ink-500">Worker safety risk</td><td>monitored</td><td>yours</td></tr>
              </tbody>
            </table>
            <p class="text-xs text-ink-500">Descriptive, not prescriptive. Going guerrilla is illegal under RA 9513 and creates real risk to utility workers if the inverter lacks anti-islanding.</p>
          </div>
        </details>
      </div>
    `;
  }

  async function populateDatalist() {
    const fc = await loadBoundaries();
    if (!fc) return;
    const list = document.getElementById("franchise-cities") as HTMLDataListElement | null;
    if (!list) return;
    const sorted = [...fc.features].sort((a: any, b: any) =>
      a.properties.name.localeCompare(b.properties.name)
    );
    list.innerHTML = sorted
      .map(
        (f: any) =>
          `<option value="${f.properties.name}">${f.properties.province}</option>`
      )
      .join("");
  }

  async function onSubmit(ev: SubmitEvent) {
    ev.preventDefault();
    const status = document.getElementById("me-status")!;
    status.textContent = "Looking up your city...";
    const form = ev.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const address = String(data.get("address") || "").trim();
    const roof = parseFloat(String(data.get("roof") || "80"));
    const bill = parseFloat(String(data.get("bill") || "8000"));
    if (!address) {
      status.textContent = "Pick a city from the list.";
      return;
    }
    const geo = await geocodeLocal(address);
    if (!geo) {
      status.textContent = "Not in Meralco's franchise. Try Quezon City, Antipolo, or any of the 61 cities in the list.";
      return;
    }
    const kwp = roof * KWP_PER_M2;
    status.textContent = "Computing...";
    const annualKwh = estimateAnnualKwh(geo.lat, geo.lon, kwp);

    const manifest = await loadManifest();
    let cityProps: any = {};
    let cityName: string | null = geo.feature?.properties?.name ?? null;
    if (manifest?.latest_quarter) {
      const fc = await loadGeoJSON(manifest.latest_quarter);
      if (fc) {
        const psgc = geo.feature?.properties?.psgc_code;
        const found =
          (psgc && fc.features.find((f: any) => f.properties.psgc_code === psgc)) ||
          findCityForPoint(fc, geo.lat, geo.lon);
        if (found) {
          cityProps = found.properties || {};
          cityName = cityProps.name ?? cityName;
        }
      }
    }
    let cityDetections: any = null;
    try {
      const counts = await fetch(`${DATA_BASE}/city_detection_counts.json`).then((r) => r.ok ? r.json() : null);
      if (counts?.rows && cityName) {
        const row = counts.rows.find((r: any) => r.name === cityName);
        const sortedDensity = [...counts.rows].filter((r: any) => r.high_per_km2 > 0).sort((a: any, b: any) => b.high_per_km2 - a.high_per_km2);
        const densityRank = row ? sortedDensity.findIndex((r: any) => r.name === cityName) + 1 : 0;
        cityDetections = row ? { ...row, densityRank, densityTotal: sortedDensity.length } : null;
      }
    } catch {}

    renderResults({
      address: geo.display_name,
      cityName,
      cityProps,
      cityDetections,
      kwp,
      annualKwh,
      monthlyBillPhp: bill,
    });
    status.textContent = "";
  }

  document.getElementById("me-form")!.addEventListener("submit", onSubmit);
  populateDatalist();

  const params = new URLSearchParams(location.search);
  const presetCity = params.get("city");
  if (presetCity) {
    const addr = document.getElementById("me-address") as HTMLInputElement;
    addr.value = presetCity.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
  }
</script>
