---
interface Props {
  pathname: string;
}
const { pathname } = Astro.props;

const links = [
  { href: "/bubong", label: "your roof" },
  { href: "/safety", label: "safety" },
  { href: "/map", label: "the map" },
  { href: "/methodology", label: "methodology" },
];
---
<header class="border-b border-ink-300/30 bg-paper">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-semibold tracking-tight no-underline text-ink-900">
      ghost-watts
    </a>
    <nav class="flex gap-5 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class={`no-underline ${pathname.startsWith(link.href) ? "text-ink-900 font-medium" : "text-ink-500 hover:text-ink-900"}`}
        >
          {link.label}
        </a>
      ))}
      <a href="https://github.com/xmpuspus/ghost-watts" class="text-ink-500 no-underline hover:text-ink-900">github</a>
    </nav>
  </div>
</header>
