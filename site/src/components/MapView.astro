---
// Map + city panel rewritten for laymen. Default surface shows rank, plain
// verdict, and city facts in everyday vocabulary. Technical breakdown
// (NIR/SWIR/LST/nightlight z-scores) hidden behind a "Show technical details"
// toggle. Methodology-grade explanation lives on /methodology, not here.
const tooltips = {
  rooftopDark: "Solar panels are darker than bare roof in near-infrared light. We measure the change vs 2022, then compare each city to the other 60. \"More\" = this city's roofs darkened more than its peers.",
  rooftopMaterial: "Solar panels reflect short-wave infrared differently from concrete or metal. Confirms the NIR signal and rules out roof-paint changes.",
  rooftopHeat: "Solar arrays run cooler than bare roofs in midday sun. We measure midday land surface temperature change vs 2022, then compare cities.",
  nightActivity: "Nighttime light change since 2022. Loosely tracks how the city's evening grid load shifted. Weakest of the four signals.",
  rooftopArea: "How much of the city is actually rooftop or pavement (km²). A 1% rooftop change over 100 km² of buildings means a lot more new solar than the same 1% over a tiny barangay.",
  permit: "How much the LGU charges for the electrical permit you'd file before installing solar legally. Same 520 kWp project: ₱153K in Rizal vs ₱16K in Laguna. April 2026 DOE circular targets a 3-day approval; not every LGU has adopted it yet.",
};
---
<section class="max-w-6xl mx-auto px-6 mb-4">
  <details class="border-l-2 border-ink-900 bg-paper-alt">
    <summary class="cursor-pointer px-4 py-2.5 text-sm font-medium text-ink-900">How to read this map</summary>
    <div class="px-4 pb-4 pt-1 text-sm text-ink-700 leading-relaxed space-y-2 max-w-prose">
      <p>Every 3 months we look at each city's roofs from satellite and compare them to the same roofs in 2022. New solar panels make rooftops <strong>darker</strong> and <strong>cooler in midday sun</strong> from above. Cities where lots of roofs changed that way score high.</p>
      <p><strong>Stronger blue = more new rooftop solar than the average city.</strong> <strong>Stronger orange = less.</strong> Click any city for the rank and the LGU permit cost. The score is a clue, not proof. Methodology and limits on <a href="/methodology" class="text-accent-steel no-underline">/methodology</a>.</p>
    </div>
  </details>
</section>

<div id="map-root" class="grid md:grid-cols-[1fr_360px] gap-4 px-6">
  <div class="relative">
    <div id="map" class="w-full h-[640px] rounded-md border border-ink-300/30 bg-ink-300/10"></div>
    <div id="legend" class="absolute bottom-3 left-3 bg-white/95 border border-ink-300/40 rounded p-3 text-xs shadow-sm">
      <div class="text-ink-500 uppercase tracking-wider text-[10px] mb-1.5 font-mono">Solar growth vs other cities</div>
      <div id="legend-bar" class="w-56 h-2 rounded mb-1.5"></div>
      <div class="grid grid-cols-3 text-[10px] text-ink-500">
        <span class="text-left">less</span>
        <span class="text-center text-ink-900">average</span>
        <span class="text-right">more</span>
      </div>
      <div id="legend-source" class="text-[10px] text-ink-300 mt-1.5 font-mono">61 cities · source: ghost-watts</div>
      <div class="flex items-center gap-2 mt-2 pt-2 border-t border-ink-300/30">
        <span class="inline-block w-3 h-3 rounded-full bg-accent-coral border border-white shadow-sm"></span>
        <span class="text-[10px] text-ink-500">Coral pins = top rooftop changes since 2022</span>
      </div>
    </div>
  </div>
  <aside id="city-panel" class="border border-ink-300/40 bg-white text-sm">
    <div id="city-empty" class="p-5">
      <p class="text-xs uppercase tracking-wider text-ink-500 mb-2 font-mono">click a city</p>
      <p class="text-ink-500">Pick any colored area on the map. You'll see whether that city has been adding rooftop solar lately, where it ranks among the 61 franchise cities, and what the LGU charges to permit a new install.</p>
    </div>
    <div id="city-detail" class="hidden">
      <div class="px-5 pt-5 pb-4">
        <p class="text-xs uppercase tracking-wider text-ink-500 mb-1 font-mono" id="city-province"></p>
        <h3 id="city-name" class="text-2xl font-semibold tracking-tight text-ink-900 leading-none mb-3"></h3>
        <p id="city-band" class="text-base leading-relaxed mb-5"></p>
        <div class="grid grid-cols-[auto_1fr] items-baseline gap-x-4 mb-2">
          <div class="text-5xl font-mono font-semibold tabular-nums leading-none text-ink-900" id="city-rank"></div>
          <div class="text-xs uppercase tracking-wider text-ink-500 font-mono">solar-growth<br/>rank<br/><span class="text-[10px] normal-case tracking-normal text-ink-300" id="city-rank-of">of 61 cities</span></div>
        </div>
        <div class="signal-bar mt-2 mb-1"><span id="city-composite-bar" class="bg-accent-steel"></span></div>
        <div class="grid grid-cols-3 text-[10px] text-ink-300">
          <span>fewer panels</span><span class="text-center">average</span><span class="text-right">more panels</span>
        </div>
      </div>

      <div class="px-5 py-4 border-t border-ink-300/30 grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
        <div>
          <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono inline-flex items-center gap-1">Rooftop area <span class="info-tip" tabindex="0" data-tip={tooltips.rooftopArea}>?</span></div>
          <div id="built-km2" class="font-mono tabular-nums text-base text-ink-900 mt-0.5"></div>
        </div>
        <div>
          <div class="text-[10px] uppercase tracking-wider text-ink-500 font-mono inline-flex items-center gap-1">LGU permit fee <span class="info-tip" tabindex="0" data-tip={tooltips.permit}>?</span></div>
          <div id="permit-fee" class="font-mono tabular-nums text-base text-ink-900 mt-0.5"></div>
          <div id="permit-days" class="font-mono tabular-nums text-[10px] text-ink-500"></div>
        </div>
      </div>

      <details class="border-t border-ink-300/30">
        <summary class="cursor-pointer px-5 py-3 text-xs uppercase tracking-wider text-ink-500 font-mono hover:bg-paper-alt">Show satellite-signal details</summary>
        <div class="px-5 pb-4 text-sm">
          <p class="text-xs text-ink-500 mb-3 leading-relaxed">
            What the four satellite channels saw in this city since 2022. Each tick shows where this city sits among 61 peers. Steel-blue = points toward solar, coral = points away.
          </p>
          <div id="city-strips" class="space-y-3"></div>
          <p class="text-[11px] text-ink-300 mt-4 leading-relaxed">
            Composite score: <span id="city-composite" class="font-mono tabular-nums text-ink-700"></span> &middot; weighted blend of all four. <a href="/methodology" class="text-accent-steel no-underline">Full algorithm</a>.
          </p>
        </div>
      </details>

      <div class="px-5 pt-4 pb-5 border-t border-ink-300/30">
        <p class="text-[11px] text-ink-500 mb-3" id="permit-source"></p>
        <button id="city-imagery-btn" class="hidden w-full mb-2 inline-flex items-center justify-center px-3 py-2 border border-ink-900 text-ink-900 text-xs font-mono uppercase tracking-wider hover:bg-ink-900 hover:text-white">
          See satellite imagery &rarr;
        </button>
        <a id="city-me-link" class="inline-flex w-full items-center justify-center px-3 py-2 bg-ink-900 text-white text-xs font-mono uppercase tracking-wider hover:bg-ink-700" href="/me">See your roof's payback &rarr;</a>
      </div>
    </div>
  </aside>
</div>

<div id="imagery-modal" class="hidden fixed inset-0 z-[100] bg-ink-900/85 backdrop-blur-sm overflow-y-auto" role="dialog" aria-modal="true">
  <div class="min-h-screen flex items-center justify-center p-4 md:p-8">
    <div class="bg-paper border border-ink-300/40 max-w-6xl w-full">
      <header class="px-6 py-4 border-b border-ink-300/30 flex items-baseline justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-wider text-ink-500 font-mono mb-1" id="imagery-province"></p>
          <h3 class="text-2xl font-semibold tracking-tight text-ink-900" id="imagery-city"></h3>
        </div>
        <button id="imagery-close" class="text-ink-500 hover:text-ink-900 text-2xl leading-none px-2" aria-label="Close">&times;</button>
      </header>
      <div class="grid md:grid-cols-3 gap-px bg-ink-300/40">
        <figure class="bg-paper p-4">
          <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-2">2022 baseline · true color</p>
          <div class="relative aspect-square bg-ink-300/10 overflow-hidden">
            <img id="imagery-baseline" class="absolute inset-0 w-full h-full object-contain" alt="2022 satellite imagery" />
            <div id="imagery-baseline-loading" class="absolute inset-0 flex items-center justify-center text-xs text-ink-300 font-mono">loading...</div>
          </div>
          <figcaption class="text-xs text-ink-500 mt-2 leading-relaxed">Sentinel-2 RGB median, Q2 2022. Same polygon as the current panel.</figcaption>
        </figure>
        <figure class="bg-paper p-4">
          <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-2">2026 Q2 current · true color</p>
          <div class="relative aspect-square bg-ink-300/10 overflow-hidden">
            <img id="imagery-current" class="absolute inset-0 w-full h-full object-contain" alt="2026 Q2 satellite imagery" />
            <div id="imagery-current-loading" class="absolute inset-0 flex items-center justify-center text-xs text-ink-300 font-mono">loading...</div>
          </div>
          <figcaption class="text-xs text-ink-500 mt-2 leading-relaxed">Sentinel-2 RGB median, Q2 2026. Look closely at the same neighborhood between the two panels.</figcaption>
        </figure>
        <figure class="bg-paper p-4">
          <p class="text-[10px] uppercase tracking-wider text-ink-500 font-mono mb-2">what changed · NIR diff</p>
          <div class="relative aspect-square bg-ink-300/10 overflow-hidden">
            <img id="imagery-diff" class="absolute inset-0 w-full h-full object-contain" alt="NIR difference 2022 to 2026" />
            <div id="imagery-diff-loading" class="absolute inset-0 flex items-center justify-center text-xs text-ink-300 font-mono">loading...</div>
          </div>
          <figcaption class="text-xs text-ink-500 mt-2 leading-relaxed">
            <strong class="text-accent-coral">Red pixels darkened</strong> in near-infrared since 2022. Solar panels darken NIR. Masked to rooftops and pavement only.
          </figcaption>
        </figure>
      </div>
      <footer class="px-6 py-3 border-t border-ink-300/30 flex flex-wrap gap-x-6 gap-y-1 text-[11px] text-ink-500 font-mono">
        <span>source: Sentinel-2 SR Harmonized via Earth Engine</span>
        <span>masked: ESA WorldCover 2021 built-up</span>
        <span>generated: <span id="imagery-generated"></span></span>
      </footer>
    </div>
  </div>
</div>

<section class="max-w-6xl mx-auto px-6 mt-10 grid gap-6 md:grid-cols-2">
  <div>
    <p class="text-xs uppercase tracking-wider text-ink-500 mb-3 font-mono">strongest solar-growth signal</p>
    <ol id="top5-signal" class="space-y-2 text-sm"></ol>
  </div>
  <div>
    <p class="text-xs uppercase tracking-wider text-ink-500 mb-3 font-mono">verified LGU permit fees</p>
    <ol id="top5-friction" class="space-y-2 text-sm"></ol>
    <p class="text-[11px] text-ink-500 mt-3 leading-relaxed">
      Most cities are still <code class="text-ink-700 bg-ink-300/15 px-1">unverified</code>. <a href="https://github.com/xmpuspus/ghost-watts" class="text-accent-steel no-underline">Contribute a source</a> with the LGU's actual residential rooftop solar permit fee.
    </p>
  </div>
</section>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { interpolateRdYlBu } from "d3-scale-chromatic";

  const DATA_BASE = "/data";

  // Tooltip strings for the satellite-signal breakdown (laymen vocabulary).
  const tooltips = {
    rooftopDark: "Solar panels are darker than bare roof in near-infrared light. We measure the change vs 2022, then compare each city to the other 60. \"More\" = this city's roofs darkened more than its peers.",
    rooftopMaterial: "Solar panels reflect short-wave infrared differently from concrete or metal. Confirms the NIR signal and rules out roof-paint changes.",
    rooftopHeat: "Solar arrays run cooler than bare roofs in midday sun. We measure midday land surface temperature change vs 2022, then compare cities.",
    nightActivity: "Nighttime light change since 2022. Loosely tracks how the city's evening grid load shifted. Weakest of the four signals.",
  };

  type CityFeature = {
    type: "Feature";
    geometry: any;
    properties: {
      name: string;
      psgc_code: string;
      province: string;
      metrics: any;
      policy: any;
      _fill?: string;
      _bound?: number;
    };
  };

  async function loadManifest() {
    try {
      const r = await fetch(`${DATA_BASE}/manifest.json`);
      if (!r.ok) return null;
      return await r.json() as { latest_quarter: string; quarters: string[] };
    } catch {
      return null;
    }
  }

  async function loadGeoJSON(quarter: string) {
    const r = await fetch(`${DATA_BASE}/ghost_watts_${quarter}.geojson`);
    if (!r.ok) throw new Error(`No data for ${quarter}`);
    return r.json();
  }

  function fmt(n: number | null | undefined, digits = 2): string {
    if (n === null || n === undefined || Number.isNaN(n)) return "n/a";
    return Number(n).toFixed(digits);
  }

  function fmtSigned(n: number | null | undefined, digits = 2): string {
    if (n === null || n === undefined || Number.isNaN(n)) return "n/a";
    const v = Number(n).toFixed(digits);
    return n > 0 ? "+" + v : v;
  }

  function colorScaleAt0(score: number, bound: number): string {
    if (bound === 0) return "#cccccc";
    const t = Math.max(0, Math.min(1, (score + bound) / (2 * bound)));
    return interpolateRdYlBu(1 - t);
  }

  function buildLegendGradient(bound: number): string {
    const stops: string[] = [];
    for (let i = 0; i <= 10; i++) {
      const t = i / 10;
      stops.push(`${interpolateRdYlBu(1 - t)} ${(t * 100).toFixed(0)}%`);
    }
    return `linear-gradient(to right, ${stops.join(", ")})`;
  }

  function bandLabel(score: number | null | undefined, rank: number | null, total: number): { headline: string; cls: string; sentence: string } {
    const rankText = rank !== null ? `Ranks <strong>${ordinal(rank)}</strong> of ${total} cities.` : "";
    if (score === null || score === undefined || Number.isNaN(score)) {
      return { headline: "Not enough satellite data this quarter.", cls: "text-ink-500", sentence: "We couldn't score this city this round. Check back next quarter." };
    }
    if (score >= 1.0) return {
      headline: "Lots of new rooftop solar here.",
      cls: "text-accent-steel font-semibold",
      sentence: `${rankText} Far more dark and cool rooftops than 2 years ago — that's what new solar arrays look like from space.`,
    };
    if (score >= 0.5) return {
      headline: "Solar adoption is picking up here.",
      cls: "text-accent-steel",
      sentence: `${rankText} More dark, cool rooftops than 2 years ago, above the franchise average.`,
    };
    if (score > -0.5) return {
      headline: "About average for the franchise.",
      cls: "text-ink-500",
      sentence: `${rankText} Roofs look about how they did 2 years ago, with no clear solar-growth pattern in this round.`,
    };
    if (score > -1.0) return {
      headline: "Less solar growth than peers.",
      cls: "text-accent-coral",
      sentence: `${rankText} Roofs got brighter or warmer than peers, the opposite of what new solar would do.`,
    };
    return {
      headline: "No detectable solar growth.",
      cls: "text-accent-coral font-semibold",
      sentence: `${rankText} The signal is the opposite of new solar. Could be reroofing, paint, or just no installations.`,
    };
  }

  function ordinal(n: number): string {
    const j = n % 10, k = n % 100;
    if (j === 1 && k !== 11) return n + "st";
    if (j === 2 && k !== 12) return n + "nd";
    if (j === 3 && k !== 13) return n + "rd";
    return n + "th";
  }

  function distributionStrip(value: number, allValues: number[], opts: { reverseTone?: boolean } = {}): string {
    const valid = allValues.filter((v) => typeof v === "number" && !Number.isNaN(v));
    if (!valid.length || typeof value !== "number" || Number.isNaN(value)) {
      return `<div class="text-[11px] text-ink-300 font-mono">no data</div>`;
    }
    const min = Math.min(...valid);
    const max = Math.max(...valid);
    const bound = Math.max(Math.abs(min), Math.abs(max));
    const span = bound * 2 || 1;
    // Tick position 0..100% using 0-anchored domain
    const t = Math.max(0, Math.min(1, (value + bound) / span));
    const tickLeft = (t * 100).toFixed(2);
    // Tone: solar-like = below baseline for raw signals (NIR/SWIR/LST), so
    // negative is "good" for those. opts.reverseTone flips for nightlight + composite.
    const tone = opts.reverseTone
      ? value > 0 ? "bg-accent-steel" : "bg-accent-coral"
      : value < 0 ? "bg-accent-steel" : "bg-accent-coral";
    return `
      <div class="relative w-full h-1.5 bg-ink-300/20 rounded">
        <div class="absolute top-0 bottom-0 left-1/2 w-px bg-ink-300/60"></div>
        <div class="absolute -top-1 -bottom-1 w-1 rounded ${tone}" style="left: calc(${tickLeft}% - 2px);"></div>
      </div>
      <div class="grid grid-cols-3 text-[9px] text-ink-300 mt-0.5">
        <span class="text-left">least</span>
        <span class="text-center">average</span>
        <span class="text-right">most</span>
      </div>
    `;
  }

  function infoTip(label: string, tip: string): string {
    return `<span class="inline-flex items-center gap-1">${label}<span tabindex="0" class="info-tip" data-tip="${tip.replace(/"/g, "&quot;")}">?</span></span>`;
  }

  function showCity(props: CityFeature["properties"], allFeatures: CityFeature[]) {
    document.getElementById("city-empty")!.classList.add("hidden");
    document.getElementById("city-detail")!.classList.remove("hidden");
    const set = (id: string, v: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    };
    const setHTML = (id: string, html: string) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    };
    const m = props.metrics ?? {};
    const p = props.policy ?? {};

    // Compute rank: 1 = highest composite. Cities with no signal at the bottom.
    const ranked = [...allFeatures]
      .filter((f) => typeof f.properties?.metrics?.composite_solar_signal_score === "number")
      .sort((a, b) => b.properties.metrics.composite_solar_signal_score - a.properties.metrics.composite_solar_signal_score);
    const total = ranked.length;
    const rank = ranked.findIndex((f) => f.properties.psgc_code === props.psgc_code) + 1 || null;

    set("city-name", props.name);
    set("city-province", props.province);
    set("city-composite", fmtSigned(m.composite_solar_signal_score));

    const composite = typeof m.composite_solar_signal_score === "number" ? m.composite_solar_signal_score : null;
    const band = bandLabel(composite, rank, total);
    const bandEl = document.getElementById("city-band");
    if (bandEl) {
      bandEl.innerHTML = `<span class="${band.cls} block mb-1">${band.headline}</span><span class="text-ink-700">${band.sentence}</span>`;
    }

    setHTML("city-rank", rank ? ordinal(rank) : "n/a");
    set("city-rank-of", rank ? `of ${total} cities` : "no rank this round");

    // Visual bar still anchored at 0 (sym domain), but no -bound/+bound chrome
    const allComp = allFeatures
      .map((f) => f.properties?.metrics?.composite_solar_signal_score)
      .filter((v: any) => typeof v === "number" && !Number.isNaN(v));
    const bound = Math.max(...allComp.map((v: number) => Math.abs(v)));
    const compositeBar = document.getElementById("city-composite-bar") as HTMLElement | null;
    if (compositeBar) {
      const t = composite !== null ? Math.max(0, Math.min(1, (composite + bound) / (2 * bound))) : 0.5;
      compositeBar.style.width = `${(t * 100).toFixed(1)}%`;
    }

    // Distribution strips per signal, with plain-language labels
    const strips: { key: string; label: string; tip: string; reverseTone?: boolean }[] = [
      { key: "s2_nir_delta_zscore", label: "Roof darkness change", tip: tooltips.rooftopDark },
      { key: "s2_swir_delta_zscore", label: "Roof material change", tip: tooltips.rooftopMaterial },
      { key: "landsat_lst_anomaly_zscore", label: "Midday rooftop heat", tip: tooltips.rooftopHeat },
      { key: "viirs_nightlight_delta_zscore", label: "Nighttime activity", tip: tooltips.nightActivity, reverseTone: true },
    ];
    setHTML(
      "city-strips",
      strips
        .map((s) => {
          const v = m[s.key];
          const allV = allFeatures.map((f: any) => f.properties?.metrics?.[s.key]).filter((x: any) => typeof x === "number");
          return `
            <div class="text-xs">
              <div class="flex items-baseline justify-between mb-1">
                <span class="text-ink-700">${infoTip(s.label, s.tip)}</span>
                <span class="font-mono tabular-nums text-ink-500 text-[10px]">${fmtSigned(v)}</span>
              </div>
              ${distributionStrip(typeof v === "number" ? v : NaN, allV, { reverseTone: s.reverseTone })}
            </div>
          `;
        })
        .join("")
    );

    setHTML("built-km2", typeof m.built_up_km2 === "number" ? `${m.built_up_km2.toFixed(1)}<span class="text-xs text-ink-500 ml-1">km²</span>` : "n/a");
    setHTML("permit-fee", p.lgu_permit_fee_php ? `₱${p.lgu_permit_fee_php.toLocaleString()}` : `<span class="text-base text-ink-300">not yet verified</span>`);
    set("permit-days", p.lgu_permit_days_p50 ? `~${p.lgu_permit_days_p50} days approval` : "");

    const sourceEl = document.getElementById("permit-source");
    if (sourceEl) {
      sourceEl.innerHTML = p.permit_data_source
        ? `Permit data source: <a href="${p.permit_data_source}" class="no-underline text-accent-steel">link</a>`
        : `Most LGUs publish their fee schedules online; this one isn't in our table yet. <a href="https://github.com/xmpuspus/ghost-watts" class="no-underline text-accent-steel">Help fill in the gap</a>.`;
    }
    const meLink = document.getElementById("city-me-link") as HTMLAnchorElement | null;
    if (meLink) {
      const slug = (props.name || "").toLowerCase().replace(/[^a-z0-9]+/g, "-");
      meLink.href = `/me?city=${encodeURIComponent(slug)}`;
    }

    // Wire imagery button (only show if at least the baseline image exists).
    const imgBtn = document.getElementById("city-imagery-btn") as HTMLButtonElement | null;
    if (imgBtn) {
      imgBtn.classList.add("hidden");
      checkImageryAvailable(props.psgc_code).then((available) => {
        if (available) {
          imgBtn.classList.remove("hidden");
          imgBtn.onclick = () => openImagery(props.psgc_code, props.name, props.province);
        }
      });
    }
  }

  const imageryCheckCache = new Map<string, Promise<boolean>>();
  function checkImageryAvailable(psgc: string): Promise<boolean> {
    if (imageryCheckCache.has(psgc)) return imageryCheckCache.get(psgc)!;
    const p = new Promise<boolean>((resolve) => {
      const img = new Image();
      img.onload = () => resolve(true);
      img.onerror = () => resolve(false);
      img.src = `/imagery/${psgc}_baseline.jpg`;
    });
    imageryCheckCache.set(psgc, p);
    return p;
  }

  function openImagery(psgc: string, name: string, province: string) {
    const modal = document.getElementById("imagery-modal");
    if (!modal) return;
    document.getElementById("imagery-city")!.textContent = name;
    document.getElementById("imagery-province")!.textContent = `${province} · before vs after`;
    const setSrc = (id: string, src: string, loadingId: string) => {
      const img = document.getElementById(id) as HTMLImageElement | null;
      const loading = document.getElementById(loadingId);
      if (!img) return;
      img.style.opacity = "0";
      if (loading) loading.style.display = "flex";
      img.onload = () => {
        img.style.opacity = "1";
        if (loading) loading.style.display = "none";
      };
      img.onerror = () => {
        if (loading) loading.textContent = "image not available";
      };
      img.src = src;
    };
    setSrc("imagery-baseline", `/imagery/${psgc}_baseline.jpg`, "imagery-baseline-loading");
    setSrc("imagery-current", `/imagery/${psgc}_current.jpg`, "imagery-current-loading");
    setSrc("imagery-diff", `/imagery/${psgc}_diff.png`, "imagery-diff-loading");
    document.getElementById("imagery-generated")!.textContent = new Date().toISOString().slice(0, 10);
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeImagery() {
    const modal = document.getElementById("imagery-modal");
    if (!modal) return;
    modal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  document.addEventListener("DOMContentLoaded", () => {
    const closeBtn = document.getElementById("imagery-close");
    if (closeBtn) closeBtn.onclick = closeImagery;
    const modal = document.getElementById("imagery-modal");
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal || (e.target as HTMLElement).closest("[role=dialog]") === modal && !((e.target as HTMLElement).closest(".bg-paper"))) {
          closeImagery();
        }
      });
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeImagery();
    });
  });

  function bboxOfFeatureCollection(fc: any): [number, number, number, number] {
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    const visit = (coords: any) => {
      if (typeof coords[0] === "number" && typeof coords[1] === "number") {
        if (coords[0] < minX) minX = coords[0];
        if (coords[0] > maxX) maxX = coords[0];
        if (coords[1] < minY) minY = coords[1];
        if (coords[1] > maxY) maxY = coords[1];
        return;
      }
      for (const c of coords) visit(c);
    };
    for (const f of fc.features ?? []) {
      if (f.geometry) visit(f.geometry.coordinates);
    }
    return [minX, minY, maxX, maxY];
  }

  function renderTop5(features: CityFeature[]) {
    const sorted = features
      .filter((f) => typeof f.properties?.metrics?.composite_solar_signal_score === "number")
      .sort((a, b) => b.properties.metrics.composite_solar_signal_score - a.properties.metrics.composite_solar_signal_score);
    const top5 = sorted.slice(0, 5);
    const max = top5.length ? top5[0].properties.metrics.composite_solar_signal_score : 1;
    const top5El = document.getElementById("top5-signal");
    if (top5El) {
      top5El.innerHTML = top5
        .map((f, i) => {
          const c = f.properties.metrics.composite_solar_signal_score;
          const pct = (Math.max(0, c) / max) * 100;
          const slug = f.properties.name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
          return `
            <li class="grid grid-cols-[auto_1fr_auto] items-center gap-3 text-sm">
              <span class="font-mono tabular-nums text-xs text-ink-500 w-4">${i + 1}</span>
              <a class="no-underline text-ink-900 hover:text-accent-steel relative" href="/map?city=${slug}">
                <span class="relative z-10">${f.properties.name}</span>
                <span class="absolute inset-y-0 left-0 bg-accent-steel/15 rounded-sm" style="width: ${pct.toFixed(1)}%"></span>
              </a>
              <span class="font-mono tabular-nums text-ink-900 text-right">${fmtSigned(c)}</span>
            </li>
          `;
        })
        .join("");
    }

    const verified = features
      .filter((f) => f.properties?.policy?.permit_data_status === "verified" && f.properties?.policy?.lgu_permit_fee_php)
      .sort((a, b) => b.properties.policy.lgu_permit_fee_php - a.properties.policy.lgu_permit_fee_php);
    const fricEl = document.getElementById("top5-friction");
    if (fricEl) {
      if (verified.length === 0) {
        fricEl.innerHTML = '<li class="text-ink-500 text-xs italic">No city-scope permit data verified yet. The two reference values currently in the dataset are at province scope, not city scope. Most LGUs publish their fee schedules online.</li>';
      } else {
        const maxFee = verified[0].properties.policy.lgu_permit_fee_php;
        fricEl.innerHTML = verified
          .slice(0, 5)
          .map((f) => {
            const fee = f.properties.policy.lgu_permit_fee_php;
            const pct = (fee / maxFee) * 100;
            return `
              <li class="grid grid-cols-[1fr_auto] items-center gap-3">
                <span class="text-ink-900 relative">
                  <span class="relative z-10">${f.properties.name}</span>
                  <span class="absolute inset-y-0 left-0 bg-accent-coral/20 rounded-sm" style="width: ${pct.toFixed(1)}%"></span>
                </span>
                <span class="font-mono tabular-nums text-ink-900">₱${fee.toLocaleString()}</span>
              </li>
            `;
          })
          .join("");
      }
    }
  }

  async function init() {
    const manifest = await loadManifest();
    const map = new maplibregl.Map({
      container: "map",
      style: {
        version: 8,
        sources: {
          osm: {
            type: "raster",
            tiles: [
              "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
              "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png",
            ],
            tileSize: 256,
            attribution: "&copy; OpenStreetMap contributors",
          },
        },
        layers: [{ id: "osm", type: "raster", source: "osm" }],
      },
      center: [121.05, 14.6],
      zoom: 9,
    });
    map.addControl(new maplibregl.NavigationControl(), "top-right");

    if (!manifest?.latest_quarter) {
      const note = document.createElement("div");
      note.className = "absolute top-4 left-4 bg-white border border-ink-300 rounded p-3 text-sm shadow z-10";
      note.innerHTML =
        "No quarterly data published yet. Run <code>python pipeline.py --quarter YYYYQN</code> in <code>/pipeline/</code>.";
      document.getElementById("map")!.appendChild(note);
      return;
    }

    map.on("load", async () => {
      try {
        const fc = await loadGeoJSON(manifest.latest_quarter);
        const composites = fc.features
          .map((f: any) => f.properties?.metrics?.composite_solar_signal_score)
          .filter((v: any) => typeof v === "number" && !Number.isNaN(v));
        const bound = Math.max(...composites.map((v: number) => Math.abs(v)));

        const byPsgc = new Map<string, CityFeature["properties"]>();
        for (const f of fc.features) {
          byPsgc.set(f.properties.psgc_code, f.properties);
          const c = f.properties?.metrics?.composite_solar_signal_score;
          f.properties._fill = colorScaleAt0(typeof c === "number" ? c : 0, bound);
          f.properties.__psgc = f.properties.psgc_code;
        }

        // Update legend
        const legendBar = document.getElementById("legend-bar") as HTMLElement | null;
        if (legendBar) legendBar.style.background = buildLegendGradient(bound);
        const lmin = document.getElementById("legend-min");
        const lmax = document.getElementById("legend-max");
        if (lmin) lmin.textContent = `-${bound.toFixed(1)}`;
        if (lmax) lmax.textContent = `+${bound.toFixed(1)}`;
        const lsource = document.getElementById("legend-source");
        if (lsource) lsource.textContent = `61 cities · ${manifest.latest_quarter} · source: ghost-watts`;

        map.addSource("ghost-watts", { type: "geojson", data: fc });
        map.addLayer({
          id: "ghost-watts-fill",
          type: "fill",
          source: "ghost-watts",
          paint: {
            "fill-color": ["get", "_fill"],
            "fill-opacity": 0.7,
          },
        });
        map.addLayer({
          id: "ghost-watts-outline",
          type: "line",
          source: "ghost-watts",
          paint: { "line-color": "#22324a", "line-width": 0.5 },
        });

        // Direct labels on the top 3 cities, rendered as HTML markers because
        // the bare OSM raster style has no glyphs URL (no symbol-layer text).
        const sortedFeatures = [...fc.features]
          .filter((f: any) => typeof f.properties?.metrics?.composite_solar_signal_score === "number")
          .sort((a: any, b: any) => b.properties.metrics.composite_solar_signal_score - a.properties.metrics.composite_solar_signal_score);
        const top3 = sortedFeatures.slice(0, 3);
        for (const f of top3) {
          const center = representativePoint(f.geometry);
          const score = f.properties.metrics.composite_solar_signal_score.toFixed(2);
          const el = document.createElement("div");
          el.className = "ghost-watts-rank-label";
          el.innerHTML = `<span class="rank-name">${f.properties.name}</span><span class="rank-score">+${score}</span>`;
          new maplibregl.Marker({ element: el, anchor: "center" })
            .setLngLat(center as [number, number])
            .addTo(map);
        }

        const [minX, minY, maxX, maxY] = bboxOfFeatureCollection(fc);
        if (Number.isFinite(minX)) {
          map.fitBounds([[minX, minY], [maxX, maxY]], { padding: 40, animate: false, maxZoom: 11 });
        }

        map.on("click", "ghost-watts-fill", (e) => {
          const f = e.features?.[0];
          if (!f) return;
          const psgc = (f.properties as any)?.__psgc ?? (f.properties as any)?.psgc_code;
          const full = psgc ? byPsgc.get(String(psgc)) : null;
          if (full) showCity(full, fc.features as CityFeature[]);
          else if (f.properties) showCity(f.properties as any, fc.features as CityFeature[]);
        });
        map.on("mouseenter", "ghost-watts-fill", () => (map.getCanvas().style.cursor = "pointer"));
        map.on("mouseleave", "ghost-watts-fill", () => (map.getCanvas().style.cursor = ""));

        renderTop5(fc.features as CityFeature[]);

        // Hot-spot pin layer: top-K darkened-pixel clusters per city.
        try {
          const hotSpotsResp = await fetch(`${DATA_BASE}/hot_spots_${manifest.latest_quarter}.geojson`);
          if (hotSpotsResp.ok) {
            const hotFc = await hotSpotsResp.json();
            map.addSource("hot-spots", { type: "geojson", data: hotFc });
            map.addLayer({
              id: "hot-spots-shadow",
              type: "circle",
              source: "hot-spots",
              paint: {
                "circle-radius": [
                  "interpolate",
                  ["linear"],
                  ["get", "area_m2"],
                  500, 6,
                  10000, 12,
                  80000, 22,
                ],
                "circle-color": "#0b1220",
                "circle-opacity": 0.35,
                "circle-blur": 0.6,
              },
            });
            map.addLayer({
              id: "hot-spots-fill",
              type: "circle",
              source: "hot-spots",
              paint: {
                "circle-radius": [
                  "interpolate",
                  ["linear"],
                  ["get", "area_m2"],
                  500, 4,
                  10000, 8,
                  80000, 16,
                ],
                "circle-color": "#d97757",
                "circle-stroke-color": "#ffffff",
                "circle-stroke-width": 1.5,
                "circle-opacity": 0.9,
              },
            });

            const popup = new maplibregl.Popup({
              closeButton: false,
              closeOnClick: false,
              offset: 12,
              className: "ghost-watts-popup",
            });

            map.on("mouseenter", "hot-spots-fill", (e) => {
              map.getCanvas().style.cursor = "pointer";
              const f = e.features?.[0];
              if (!f) return;
              const p = f.properties as any;
              const area = Number(p.area_m2 || 0);
              const kwp = Number(p.kwp_equiv || 0);
              const ha = (area / 10000).toFixed(1);
              popup
                .setLngLat((f.geometry as any).coordinates)
                .setHTML(
                  `<div class="text-xs font-mono leading-snug">
                     <div class="text-ink-900 font-semibold mb-1">${p.city}</div>
                     <div class="text-ink-700">${ha} ha rooftop change</div>
                     <div class="text-ink-500">~${Math.round(kwp).toLocaleString()} kWp equiv if all solar</div>
                   </div>`
                )
                .addTo(map);
            });
            map.on("mouseleave", "hot-spots-fill", () => {
              map.getCanvas().style.cursor = "";
              popup.remove();
            });
            map.on("click", "hot-spots-fill", (e) => {
              const f = e.features?.[0];
              if (!f) return;
              const p = f.properties as any;
              openImagery(p.psgc_code, p.city, p.province);
            });
          }
        } catch (err) {
          // No hot-spots yet; that's fine
        }

        const params = new URLSearchParams(location.search);
        const cityParam = params.get("city");
        if (cityParam) {
          const slug = cityParam.toLowerCase().replace(/[^a-z0-9]+/g, "-");
          const match = (fc.features as CityFeature[]).find(
            (f) => f.properties.name.toLowerCase().replace(/[^a-z0-9]+/g, "-") === slug
          );
          if (match) showCity(match.properties, fc.features as CityFeature[]);
        }
      } catch (err) {
        console.error(err);
      }
    });
  }

  function representativePoint(geom: any): [number, number] {
    if (!geom) return [121.05, 14.6];
    const polys = geom.type === "Polygon" ? [geom.coordinates] : geom.coordinates;
    let bestArea = 0;
    let bestCenter: [number, number] = [121.05, 14.6];
    for (const poly of polys) {
      const ring = poly[0];
      if (!ring) continue;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const pt of ring) {
        if (pt[0] < minX) minX = pt[0];
        if (pt[0] > maxX) maxX = pt[0];
        if (pt[1] < minY) minY = pt[1];
        if (pt[1] > maxY) maxY = pt[1];
      }
      const area = (maxX - minX) * (maxY - minY);
      if (area > bestArea) {
        bestArea = area;
        bestCenter = [(minX + maxX) / 2, (minY + maxY) / 2];
      }
    }
    return bestCenter;
  }

  init();
</script>

