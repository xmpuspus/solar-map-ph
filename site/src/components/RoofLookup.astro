  // ── Address autocomplete ─────────────────────────────────────────────
  // Live Photon-backed suggestions as the user types. Solves the failure mode
  // where the user types a real PH address that OSM doesn't have under that
  // exact name (e.g. "Madison Park West"); they instead see what Photon DOES
  // know nearby and pick from there. Key gain over single-shot geocoding:
  // failure becomes "no suggestions appear", not "couldn't find that".
  type AddressSuggestion = { label: string; sub: string; lat: number; lon: number };

  const addrInput = document.getElementById("roof-address") as HTMLInputElement;
  const suggestList = document.getElementById("roof-address-suggest") as HTMLUListElement;
  let acSuggestions: AddressSuggestion[] = [];
  let acActiveIdx = -1;
  let acPicked: AddressSuggestion | null = null;
  let acTimer: ReturnType<typeof setTimeout> | null = null;
  let acLastQuery = "";

  function escapeHtml(s: string): string {
    return s.replace(/[<>&'"]/g, (c) => ({"<":"&lt;",">":"&gt;","&":"&amp;","'":"&#39;","\"":"&quot;"}[c] as string));
  }

  function renderSuggestions() {
    if (acSuggestions.length === 0) {
      suggestList.classList.add("hidden");
      suggestList.innerHTML = "";
      addrInput.setAttribute("aria-expanded", "false");
      return;
    }
    suggestList.classList.remove("hidden");
    addrInput.setAttribute("aria-expanded", "true");
    suggestList.innerHTML = acSuggestions.map((s, i) => `
      <li role="option" aria-selected="${i === acActiveIdx}">
        <button type="button" data-idx="${i}"
          class="w-full text-left px-3 py-2 text-sm border-b border-ink-300/30 last:border-b-0 ${i === acActiveIdx ? 'bg-ink-100' : 'hover:bg-ink-100'}">
          <div class="text-ink-900">${escapeHtml(s.label || s.sub || "(no label)")}</div>
          ${s.sub ? `<div class="text-xs text-ink-500">${escapeHtml(s.sub)}</div>` : ""}
        </button>
      </li>
    `).join("");
    suggestList.querySelectorAll<HTMLButtonElement>("button[data-idx]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.dataset.idx!, 10);
        pickSuggestion(acSuggestions[idx]);
      });
    });
  }

  function pickSuggestion(s: AddressSuggestion) {
    acPicked = s;
    addrInput.value = [s.label, s.sub].filter(Boolean).join(", ");
    suggestList.classList.add("hidden");
    suggestList.innerHTML = "";
    acActiveIdx = -1;
    addrInput.setAttribute("aria-expanded", "false");
  }

  async function refreshSuggestions(q: string) {
    if (q === acLastQuery) return;
    acLastQuery = q;
    let features: any[] = [];
    try {
      features = await photonSearch(q, 8);
    } catch {
      // Autocomplete fails silently; the user can still submit and we'll
      // surface a "service busy" message there if it's actually down.
      features = [];
    }
    if (q !== acLastQuery) return;   // stale
    acSuggestions = features.map(photonFeatureToLabel).filter((s) => s.label || s.sub);
    acActiveIdx = -1;
    renderSuggestions();
  }

  addrInput.addEventListener("input", () => {
    acPicked = null;
    const q = addrInput.value.trim();
    if (acTimer) clearTimeout(acTimer);
    if (q.length < 3) {
      acSuggestions = [];
      renderSuggestions();
      return;
    }
    acTimer = setTimeout(() => refreshSuggestions(q), 250);
  });

  addrInput.addEventListener("keydown", (e) => {
    if (suggestList.classList.contains("hidden")) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      acActiveIdx = Math.min(acSuggestions.length - 1, acActiveIdx + 1);
      renderSuggestions();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      acActiveIdx = Math.max(0, acActiveIdx - 1);
      renderSuggestions();
    } else if (e.key === "Enter" && acActiveIdx >= 0) {
      e.preventDefault();
      pickSuggestion(acSuggestions[acActiveIdx]);
    } else if (e.key === "Escape") {
      suggestList.classList.add("hidden");
      acActiveIdx = -1;
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!addrInput.contains(target) && !suggestList.contains(target)) {
      suggestList.classList.add("hidden");
      acActiveIdx = -1;
      addrInput.setAttribute("aria-expanded", "false");
    }
  });

  // Sample-address chips: one click fills the input AND triggers autocomplete
  // so the user can refine immediately. If they hit submit without picking, the
  // chip text itself is geocodable via the fallback path.
  document.querySelectorAll<HTMLButtonElement>("button[data-fill]").forEach((btn) => {
    btn.addEventListener("click", () => {
      addrInput.value = btn.dataset.fill!;
      addrInput.focus();
      acPicked = null;
      acLastQuery = "";
      refreshSuggestions(addrInput.value);
    });
  });

  // Single entry point for a lookup: guards against double-submit, locks the
  // buttons + shows a working label, and turns a thrown ServiceError into a
  // clear "service busy" message (vs the misleading "address not found").
  let isRunning = false;
  async function submitLookup(opts: { address: string; bill: number; residents: string; presetGeo?: LatLon }) {
    if (isRunning) return;
    isRunning = true;
    const submitBtn = document.getElementById("roof-submit") as HTMLButtonElement | null;
    const geoBtn = document.getElementById("roof-geo") as HTMLButtonElement | null;
    const status = document.getElementById("roof-status")!;
    const origLabel = submitBtn ? submitBtn.innerHTML : "";
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Checking your roof…"; }
    if (geoBtn) geoBtn.disabled = true;
    try {
      await run(opts);
    } catch (err) {
      status.textContent = (err instanceof ServiceError)
        ? "The address service is busy right now. Wait a few seconds and try again."
        : "Something went wrong. Try again, or pick a sample address.";
    } finally {
      isRunning = false;
      if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = origLabel; }
      if (geoBtn) geoBtn.disabled = false;
    }
  }

  function currentBill(): number {
    return parseFloat((document.getElementById("roof-bill") as HTMLInputElement)?.value || "8000");
  }
  function currentResidents(): string {
    return (document.getElementById("roof-residents") as HTMLSelectElement)?.value || "4";
  }

  document.getElementById("roof-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const address = String(data.get("address") || "").trim();
    const bill = parseFloat(String(data.get("bill") || "8000"));
    const residents = String(data.get("residents") || "4");
    if (!address) return;
    // Make the result shareable: round-trip the address through the URL so a
    // copied link reproduces this lookup for whoever opens it.
    try { history.replaceState(null, "", `?address=${encodeURIComponent(address)}`); } catch {}
    // If the user picked a suggestion, run() uses the lat/lon directly.
    await submitLookup({ address, bill, residents });
  });

  // "Use my location": skip typing and geocoding entirely.
  document.getElementById("roof-geo")?.addEventListener("click", () => {
    const status = document.getElementById("roof-status")!;
    if (!("geolocation" in navigator)) {
      status.textContent = "Your browser can't share location. Type your address instead.";
      return;
    }
    status.textContent = "Getting your location…";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        try { history.replaceState(null, "", location.pathname); } catch {}
        submitLookup({
          address: "Your location",
          bill: currentBill(),
          residents: currentResidents(),
          presetGeo: { lat: pos.coords.latitude, lon: pos.coords.longitude, display_name: "Your location" },
        });
      },
      () => { status.textContent = "Couldn't get your location. Type your address instead."; },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 },
    );
  });

  // Pre-fill AND auto-run from a shared link (/?address=...): the recipient sees
  // the result immediately instead of a blank form.
  const presetParams = new URLSearchParams(location.search);
  const presetAddress = presetParams.get("address");
  if (presetAddress) {
    addrInput.value = presetAddress;
    submitLookup({ address: presetAddress, bill: currentBill(), residents: currentResidents() });
  }
</script>

<style is:global>
  @media print {
    header, footer, #roof-form, .print\:hidden { display: none !important; }
    #roof-results { margin-top: 0 !important; }
    a[href]::after { content: "" !important; }
  }
</style>
