---
// RoofLookup: address to roof score to savings.
// Client-side flow:
//   1. Geocode address via Nominatim (Filipino-only)
//   2. Query Overpass for building polygons within 80m of point
//   3. Pick the polygon containing the point, or the nearest by centroid
//   4. Compute roof area (turf area), centroid, bbox
//   5. Fetch a hi-res Esri tile centered on the building
//   6. Render image + SVG polygon overlay
//   7. Compute solar potential (PVGIS-derived constant), payback
//   8. Compute roof score (area + irradiance + size relative to peers)
//   9. Surface neighborhood context: distance to verified case studies,
//      and the user's city's composite signal rank
//  10. Surface LGU permit cost from the existing friction table
//
// The tariff, install cost and yield constants are NOT hardcoded here. They come
// from public/data/tariff.json at build time, each with the month it was read,
// and ride into the client script as a JSON block below. See src/data/tariff.ts.
import { clientTariff } from "../data/tariff";
---
<script is:inline type="application/json" id="tariff-data" set:html={JSON.stringify(clientTariff)}></script>

<!-- max-w-5xl matches the hero, the deliverables strip and the results block, so
     every left edge on the page lines up with the headline. Running text inside
     stays at a readable measure with its own max-width. -->
<form id="roof-form" class="max-w-5xl mx-auto px-6 grid gap-4">
  <div class="grid gap-2">
    <label class="text-sm text-ink-700" for="roof-address">Your address (anywhere in Meralco's franchise)</label>
    <div class="relative">
      <input
        id="roof-address"
        name="address"
        type="text"
        required
        placeholder="Start typing, then pick from the list"
        class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="roof-address-suggest"
        aria-expanded="false"
      />
      <ul
        id="roof-address-suggest"
        role="listbox"
        class="hidden absolute z-30 left-0 right-0 mt-1 max-h-72 overflow-y-auto bg-surface border border-ink-300 rounded-md shadow-lg"
      ></ul>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-ink-500">Try:</span>
      <button type="button" data-fill="SM Megamall, Mandaluyong" class="px-2.5 py-1.5 border border-ink-300/60 rounded-full text-ink-700 hover:bg-paper-alt hover:text-ink-900 font-mono">SM Megamall</button>
      <button type="button" data-fill="Tomas Morato, Quezon City" class="px-2.5 py-1.5 border border-ink-300/60 rounded-full text-ink-700 hover:bg-paper-alt hover:text-ink-900 font-mono">Tomas Morato, QC</button>
      <button type="button" data-fill="BGC, Taguig" class="px-2.5 py-1.5 border border-ink-300/60 rounded-full text-ink-700 hover:bg-paper-alt hover:text-ink-900 font-mono">BGC</button>
      <button type="button" data-fill="Antipolo, Rizal" class="px-2.5 py-1.5 border border-ink-300/60 rounded-full text-ink-700 hover:bg-paper-alt hover:text-ink-900 font-mono">Antipolo</button>
      <button type="button" data-fill="Bacoor, Cavite" class="px-2.5 py-1.5 border border-ink-300/60 rounded-full text-ink-700 hover:bg-paper-alt hover:text-ink-900 font-mono">Bacoor</button>
    </div>
    <p class="text-xs text-ink-500 max-w-2xl">We'll tell you whether you can install solar on your roof, what it would save you, and what your block's grid saturation means for approval. Address is not stored.</p>
  </div>
  <div class="grid gap-2 md:grid-cols-2">
    <div class="grid gap-1.5">
      <label class="text-sm text-ink-700" for="roof-bill">Monthly Meralco bill (₱)</label>
      <input
        id="roof-bill"
        name="bill"
        type="number"
        min="500"
        max="100000"
        value="8000"
        step="100"
        class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface font-mono tabular-nums"
      />
      <p class="text-xs text-ink-500">Your average monthly bill. Edit it so the payback is yours, not a stranger's.</p>
    </div>
    <div class="grid gap-1.5">
      <label class="text-sm text-ink-700" for="roof-residents">Household size (sets your usage benchmark)</label>
      <select
        id="roof-residents"
        name="residents"
        class="w-full border border-ink-300 rounded-md px-3 py-2 text-sm bg-surface"
      >
        <option value="1">1 person</option>
        <option value="2">2 people</option>
        <option value="3">3 people</option>
        <option value="4" selected>4 people</option>
        <option value="5">5 people</option>
        <option value="6">6+ people</option>
      </select>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 justify-between">
    <div class="flex items-center gap-3">
      <button type="submit" id="roof-submit" class="btn">Can I install solar? &rarr;</button>
      <button type="button" id="roof-geo" class="inline-flex items-center gap-1.5 min-h-[44px] text-xs font-mono uppercase tracking-wider text-accent-steel hover:text-ink-900 no-underline">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/></svg>
        use my location
      </button>
    </div>
    <span id="roof-status" role="status" aria-live="polite" class="text-sm text-ink-500"></span>
  </div>
</form>

<div id="roof-results" class="hidden max-w-5xl mx-auto px-6 mt-10"></div>

<script>
  import area from "@turf/area";
  import centroid from "@turf/centroid";
  import distance from "@turf/distance";
  import booleanPointInPolygon from "@turf/boolean-point-in-polygon";

  type LatLon = { lat: number; lon: number; display_name: string };
  type Building = {
    osmId: number;
    coords: number[][]; // outer ring as [lon, lat][]
    geojson: any;
    areaM2: number;
    center: [number, number];
    bboxM: { minLon: number; minLat: number; maxLon: number; maxLat: number };
    buildingType: string | null;  // OSM building tag value
    isResidential: boolean;
    isCommercial: boolean;
  };

  const RESIDENTIAL_TAGS = new Set(["residential", "house", "apartments", "detached", "semidetached_house", "terrace", "bungalow", "dormitory"]);
  const COMMERCIAL_TAGS = new Set(["commercial", "retail", "supermarket", "mall", "office", "industrial", "warehouse", "factory", "cathedral", "church", "religious", "school", "hospital", "civic", "government", "stadium"]);
  const RESIDENTIAL_AREA_CEILING_M2 = 500; // anything bigger is suspicious for residential

  // Dated inputs, read from the JSON block the Astro frontmatter emitted. The
  // source of truth is public/data/tariff.json, refreshed when Meralco posts a
  // new advisory. Every peso figure the tool prints carries RATE_AS_OF with it.
  const TARIFF = JSON.parse(
    document.getElementById("tariff-data")?.textContent ?? "{}",
  ) as {
    ratePhpPerKwh: number;
    rateAsOfLabel: string;
    rateSourceUrl: string;
    installPhpPerKwp: number;
    installLow: number;
    installHigh: number;
    installAsOfLabel: string;
    yieldKwhPerKwpPerYear: number;
    netMeteringCapKw: number;
    duDecisionWorkingDays: number;
    netMeteringAsOfLabel: string;
  };

  const MERALCO_RATE_PHP_PER_KWH = TARIFF.ratePhpPerKwh;
  const RATE_AS_OF = TARIFF.rateAsOfLabel;
  const RATE_SOURCE_URL = TARIFF.rateSourceUrl;
  const INSTALL_COST_PHP_PER_KWP = TARIFF.installPhpPerKwp;
  const INSTALL_COST_LOW = TARIFF.installLow;
  const INSTALL_COST_HIGH = TARIFF.installHigh;
  const NET_METERING_CAP_KW = TARIFF.netMeteringCapKw;
  const DU_DECISION_DAYS = TARIFF.duDecisionWorkingDays;
  const KWP_PER_M2 = 0.15;
  const SYSTEM_LIFETIME_YEARS = 25;
  const DEGRADATION_PER_YEAR = 0.005;
  const PH_KWH_PER_KWP_PER_YEAR = TARIFF.yieldKwhPerKwpPerYear;

  // Typical Meralco residential consumption per household size (kWh/month).
  // Source: DOE/Meralco aggregate disclosures and ICSC household surveys.
  const TYPICAL_KWH_BY_RESIDENTS: Record<string, [number, number]> = {
    "1": [80, 180],
    "2": [120, 280],
    "3": [180, 380],
    "4": [240, 480],
    "5": [300, 580],
    "6": [380, 700],
  };

  // Photon's lat/lon proximity bias weights NCR results higher even for ambiguous
  // strings (e.g., "Madison Park" no longer prefers a US suburb).
  const PHOTON_BIAS_LAT = 14.6;
  const PHOTON_BIAS_LON = 121.0;

  // A transport-level failure (network down, timeout, 429 rate-limit, 5xx) from
  // a free upstream service. Distinguished from "no result" so the UI can say
  // "the service is busy" instead of the misleading "address not found".
  class ServiceError extends Error {
    constructor(public service: string) { super(`${service} unavailable`); }
  }

  function sleep(ms: number) { return new Promise((r) => setTimeout(r, ms)); }

  async function fetchWithTimeout(url: string, opts: RequestInit = {}, ms = 12000): Promise<Response> {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), ms);
    try {
      return await fetch(url, { ...opts, signal: ctrl.signal });
    } finally {
      clearTimeout(t);
    }
  }

  // Fetch with a client-side timeout and one jittered retry on network error /
  // 429 / 5xx. Throws ServiceError if every attempt fails. Free endpoints
  // (Overpass, Photon) throttle under load, so this keeps a traffic spike from
  // hanging the flow or surfacing a wrong error.
  async function fetchResilient(url: string, opts: RequestInit, service: string, tries = 2, timeoutMs = 12000): Promise<Response> {
    for (let i = 0; i < tries; i++) {
      try {
        const r = await fetchWithTimeout(url, opts, timeoutMs);
        if (r.status !== 429 && r.status < 500) return r;
      } catch {
        // network error / abort -> fall through to retry
      }
      if (i < tries - 1) await sleep(400 + Math.random() * 600);
    }
    throw new ServiceError(service);
  }

  async function photonSearch(q: string, limit = 8): Promise<any[]> {
    const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=${limit}&lang=en&lat=${PHOTON_BIAS_LAT}&lon=${PHOTON_BIAS_LON}`;
    const r = await fetchResilient(url, {}, "address search", 2, 10000);
    if (!r.ok) return [];
    try {
      const d = await r.json();
      return (d.features || []).filter((f: any) =>
        f.properties?.countrycode === "PH" || f.properties?.country === "Philippines"
      );
    } catch {
      return [];
    }
  }

  function photonFeatureToLabel(f: any): { label: string; sub: string; lat: number; lon: number } {
    const [lon, lat] = f.geometry.coordinates;
    const p = f.properties || {};
    const labelParts = [p.name, p.street, p.housenumber].filter(Boolean);
    const subParts = [p.locality, p.district, p.city, p.county, p.state].filter(Boolean);
    return {
      label: labelParts.join(" ") || subParts[0] || "",
      sub: Array.from(new Set(subParts)).slice(0, 3).join(", "),
      lat, lon,
    };
  }

  // Returns a match, or null when the services responded but had no result
  // ("not found"). Throws ServiceError when the upstream geocoders are
  // unreachable/throttled, so the caller can tell the two apart.
  async function geocode(q: string): Promise<LatLon | null> {
    // Try a few query variants to catch the case where users type "BGC, Taguig"
    // (Photon may not match the abbreviation) or addresses where the literal
    // string isn't tagged but the locality is.
    let serviceFailed = false;
    const tries = [q, q + ", Philippines"];
    for (const variant of tries) {
      let features: any[] = [];
      try {
        features = await photonSearch(variant, 5);
      } catch {
        serviceFailed = true;
      }
      const f = features[0];
      if (f?.geometry?.coordinates) {
        const [lon, lat] = f.geometry.coordinates;
        const p = f.properties || {};
        const parts = [p.name, p.city || p.locality, p.state, p.country].filter(Boolean);
        return { lat, lon, display_name: parts.join(", ") };
      }
    }
    // Fallback: Nominatim
    try {
      const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&countrycodes=ph&limit=1&accept-language=en`;
      const r = await fetchWithTimeout(url, {}, 12000);
      if (r.status === 429 || r.status >= 500) throw new ServiceError("geocoder");
      if (r.ok) {
        const arr = await r.json();
        if (arr.length) {
          return { lat: parseFloat(arr[0].lat), lon: parseFloat(arr[0].lon), display_name: arr[0].display_name };
        }
      }
    } catch (e) {
      if (e instanceof ServiceError) throw e;
      serviceFailed = true;
    }
    if (serviceFailed) throw new ServiceError("geocoder");
    return null;
  }

  async function fetchBuildings(lat: number, lon: number, radius = 80): Promise<Building[]> {
    const query = `[out:json][timeout:25];(way["building"](around:${radius},${lat},${lon});relation["building"](around:${radius},${lat},${lon}););out geom;`;
    const url = `https://overpass-api.de/api/interpreter`;
    // Overpass is the flakiest dependency under load; bound it with a client
    // timeout + retry and surface a "busy" signal rather than hanging 25s.
    const r = await fetchResilient(url, {
      method: "POST",
      body: "data=" + encodeURIComponent(query),
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
    }, "building service", 2, 18000);
    if (!r.ok) return [];
    const data = await r.json();
    const out: Building[] = [];
    for (const el of data.elements || []) {
      let coords: number[][] | null = null;
      if (el.type === "way" && el.geometry) {
        coords = el.geometry.map((p: any) => [p.lon, p.lat]);
      } else if (el.type === "relation" && el.members) {
        const outer = el.members.find((m: any) => m.role === "outer" && m.geometry);
        if (outer && outer.geometry) {
          coords = outer.geometry.map((p: any) => [p.lon, p.lat]);
        }
      }
      if (!coords || coords.length < 4) continue;
      // Close the ring if not already
      if (coords[0][0] !== coords[coords.length - 1][0] || coords[0][1] !== coords[coords.length - 1][1]) {
        coords.push(coords[0]);
      }
      const geo = { type: "Feature" as const, geometry: { type: "Polygon" as const, coordinates: [coords] }, properties: {} };
      const a = area(geo as any);
      if (a < 12) continue; // skip tiny ones
      const c = centroid(geo as any).geometry.coordinates as [number, number];
      const lons = coords.map((p) => p[0]);
      const lats = coords.map((p) => p[1]);
      const tags = el.tags || {};
      const buildingType = tags.building && tags.building !== "yes" ? tags.building : (tags.amenity || tags.shop || null);
      const isResidential = !!buildingType && RESIDENTIAL_TAGS.has(buildingType);
      const isCommercial = !!buildingType && COMMERCIAL_TAGS.has(buildingType);
      out.push({
        osmId: el.id,
        coords,
        geojson: geo,
        areaM2: a,
        center: c,
        bboxM: {
          minLon: Math.min(...lons),
          maxLon: Math.max(...lons),
          minLat: Math.min(...lats),
          maxLat: Math.max(...lats),
        },
        buildingType,
        isResidential,
        isCommercial,
      });
    }
    return out;
  }

  function pickBuilding(point: [number, number], buildings: Building[]): Building | null {
    if (!buildings.length) return null;
    const inside: Building[] = [];
    for (const b of buildings) {
      if (booleanPointInPolygon({ type: "Point", coordinates: point } as any, b.geojson as any)) {
        inside.push(b);
      }
    }
    // If we land inside one or more buildings, prefer residential, then smallest area.
    if (inside.length) {
      const residential = inside.filter((b) => b.isResidential);
      if (residential.length) {
        residential.sort((a, b) => a.areaM2 - b.areaM2);
        return residential[0];
      }
      inside.sort((a, b) => a.areaM2 - b.areaM2);
      return inside[0];
    }
    // Otherwise: nearest residential within range, falling back to nearest of any kind.
    const ranked = buildings
      .map((b) => ({ b, d: distance({ type: "Point", coordinates: point } as any, { type: "Point", coordinates: b.center } as any, { units: "meters" } as any) }))
      .sort((a, b) => a.d - b.d);
    const nearestResidential = ranked.find((r) => r.b.isResidential && r.d < 50);
    if (nearestResidential) return nearestResidential.b;
    return ranked[0]?.b ?? null;
  }

  function paddedBbox(b: Building, padMeters = 60) {
    // Square the bbox in real meters before requesting from Esri. A non-square
    // bbox at size=600,600 (which we always request) makes Esri return a blank
    // / zoomed-out tile for some buildings. That was the broken-image bug.
    // Always pad to at least 60 m half-width so a small house gets a usable
    // ~120 m view; for big buildings the half-width grows with the longest
    // building axis + padMeters.
    const cLat = (b.bboxM.minLat + b.bboxM.maxLat) / 2;
    const cLon = (b.bboxM.minLon + b.bboxM.maxLon) / 2;
    const lonScale = 111000 * Math.cos((cLat * Math.PI) / 180);
    const halfLonM = ((b.bboxM.maxLon - b.bboxM.minLon) * lonScale) / 2;
    const halfLatM = ((b.bboxM.maxLat - b.bboxM.minLat) * 111000) / 2;
    const halfM = Math.max(60, Math.max(halfLonM, halfLatM) + padMeters);
    const halfLat = halfM / 111000;
    const halfLon = halfM / lonScale;
    return {
      minLon: cLon - halfLon,
      maxLon: cLon + halfLon,
      minLat: cLat - halfLat,
      maxLat: cLat + halfLat,
    };
  }

  function esriExportUrl(bbox: { minLon: number; maxLon: number; minLat: number; maxLat: number }, sizePx = 600): string {
    const params = new URLSearchParams({
      bbox: `${bbox.minLon},${bbox.minLat},${bbox.maxLon},${bbox.maxLat}`,
      bboxSR: "4326",
      size: `${sizePx},${sizePx}`,
      imageSR: "3857",
      format: "jpg",
      f: "image",
    });
    return `https://services.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/export?${params}`;
  }

  function projectToImage(
    coords: number[][],
    bbox: { minLon: number; maxLon: number; minLat: number; maxLat: number },
    sizePx = 600
  ): string {
    // Returns SVG path string
    const dx = bbox.maxLon - bbox.minLon;
    const dy = bbox.maxLat - bbox.minLat;
    const pts = coords.map(([lon, lat]) => {
      const x = ((lon - bbox.minLon) / dx) * sizePx;
      const y = sizePx - ((lat - bbox.minLat) / dy) * sizePx;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    });
    return `M ${pts.join(" L ")} Z`;
  }

  function estimateAnnualKwh(lat: number, kwp: number): number {
    const adjust = 1 + (14.65 - lat) * 0.015;
    return kwp * PH_KWH_PER_KWP_PER_YEAR * adjust;
  }

  function paybackYears(installCost: number, annualSavings: number): number {
    if (annualSavings <= 0) return Infinity;
    return installCost / annualSavings;
  }

  function lifetimeNpv(annualKwh: number, ratePhpKwh: number, installCost: number): number {
    let total = -installCost;
    let kwh = annualKwh;
    for (let y = 0; y < SYSTEM_LIFETIME_YEARS; y++) {
      total += kwh * ratePhpKwh;
      kwh *= 1 - DEGRADATION_PER_YEAR;
    }
    return total;
  }

  function fmtCurrency(n: number, compact = false): string {
    if (compact && n >= 1_000_000) return `₱${(n / 1_000_000).toFixed(2)}M`;
    if (compact && n >= 1000) return `₱${(n / 1000).toFixed(0)}K`;
    return `₱${Math.round(n).toLocaleString()}`;
  }

  function roofScore(opts: { areaM2: number; lat: number; aspectRatio: number }): { score: number; breakdown: Record<string, number> } {
    // 0-100, weighted from area + irradiance + shape proxy (compactness)
    // area: 100 m² = 50, 200 m² = 70, 400 m² = 90, 800+ m² = 100
    const areaScore = Math.min(100, 30 + 35 * Math.log10(Math.max(20, opts.areaM2) / 50));
    // irradiance: lat 14-16 in PH all good; small adjustment
    const irrScore = 70 + (14.65 - opts.lat) * 1.5;
    // aspect: too narrow = bad; ~1:1 to 1:3 ideal
    const aspectPenalty = Math.max(0, opts.aspectRatio - 3) * 5;
    const aspectScore = Math.max(40, 90 - aspectPenalty);
    const composite = Math.round(0.5 * areaScore + 0.3 * irrScore + 0.2 * aspectScore);
    return {
      score: Math.max(0, Math.min(100, composite)),
      breakdown: {
        area: Math.round(areaScore),
        irradiance: Math.round(irrScore),
        shape: Math.round(aspectScore),
      },
    };
  }

  function bandFromScore(score: number): { label: string; color: string; advice: string } {
    if (score >= 80) return { label: "excellent", color: "text-accent-steel font-semibold", advice: "Strong fit for solar. Worth getting quotes." };
    if (score >= 65) return { label: "good", color: "text-accent-steel", advice: "Likely worth installing if you stay 5+ years." };
    if (score >= 50) return { label: "fair", color: "text-ink-700", advice: "Possible, but check roof orientation and shading first." };
    if (score >= 35) return { label: "limited", color: "text-accent-coral-dark", advice: "Constrained by size or shading. Consider a smaller system or efficiency upgrades first." };
    return { label: "poor fit", color: "text-accent-coral-dark font-semibold", advice: "Solar is unlikely to pay back here. Try efficiency upgrades and time-shifting first." };
  }

  // Cache loaded JSON for the session so a 2nd/3rd lookup doesn't re-fetch and
  // re-parse the same multi-MB GeoJSON. Failed loads aren't cached (so a
  // transient error can be retried).
  const _jsonCache = new Map<string, Promise<any>>();
  function loadJson(path: string): Promise<any> {
    const hit = _jsonCache.get(path);
    if (hit) return hit;
    const p = (async () => {
      try {
        const r = await fetchWithTimeout(path, {}, 15000);
        if (!r.ok) return null;
        return await r.json();
      } catch {
        return null;
      }
    })();
    _jsonCache.set(path, p);
    p.then((v) => { if (v == null) _jsonCache.delete(path); }).catch(() => _jsonCache.delete(path));
    return p;
  }

  type CaseStudy = { id: string; city: string; province: string; lat: number; lon: number; area_m2: number; kwp_equiv: number; image_path: string; note: string };
  type Detection = { lat: number; lon: number; score: number; tier: "high" | "candidate"; tile_id: string; distanceKm: number };
  type SaturationCell = {
    cellLat: number;
    cellLon: number;
    nPanelsHigh: number;
    nPanelsCandidate: number;
    nBuildingsSolar: number;
    sumKwpInstalled: number;
    tier: "early" | "growing" | "saturated";
  };

  type VerdictKind =
    | "yes-pioneer"
    | "yes-normal"
    | "yes-saturated"
    | "already-has"
    | "too-small"
    | "commercial"
    | "outside-franchise";
  type VerdictTone = "go" | "caution" | "stop" | "info";
  type VerdictBullet = { kind: "size" | "money" | "neighborhood" | "alert"; text: string };
  type Verdict = {
    kind: VerdictKind;
    tone: VerdictTone;
    headline: string;
    subhead: string;
    bullets: VerdictBullet[];
    nextSteps: { label: string; href: string }[];
  };
  type PerBuildingDetection = {
    osmId: number;
    panelAreaM2: number;
    kwpEstimate: number;
    confidence: number;
    tile_id: string;
    panelPolygon: number[][];
  };

  async function nearbyDetections(point: [number, number], radiusKm = 1.5): Promise<Detection[]> {
    const fc = await loadJson("/data/rooftop_solar_ncr.geojson");
    if (!fc?.features) return [];
    const out: Detection[] = [];
    for (const f of fc.features) {
      const [lon, lat] = f.geometry.coordinates;
      const d = distance(
        { type: "Point", coordinates: point } as any,
        { type: "Point", coordinates: [lon, lat] } as any,
        { units: "kilometers" } as any
      );
      if (d > radiusKm) continue;
      const props = f.properties ?? {};
      const score = typeof props.score === "number" ? props.score : 0;
      const tier = props.tier === "high" ? "high" : "candidate";
      out.push({ lat, lon, score, tier, tile_id: props.tile_id ?? "", distanceKm: d });
    }
    out.sort((a, b) => {
      if (a.tier !== b.tier) return a.tier === "high" ? -1 : 1;
      return a.distanceKm - b.distanceKm;
    });
    return out;
  }

  async function saturationCellAt(lon: number, lat: number): Promise<SaturationCell | null> {
    const fc = await loadJson("/data/solar_saturation_ncr.geojson");
    if (!fc?.features) return null;
    const pt = { type: "Point", coordinates: [lon, lat] } as any;
    for (const f of fc.features) {
      if (booleanPointInPolygon(pt, f as any)) {
        const p = f.properties ?? {};
        return {
          cellLat: p.cell_lat,
          cellLon: p.cell_lon,
          nPanelsHigh: p.n_panels_high ?? 0,
          nPanelsCandidate: p.n_panels_candidate ?? 0,
          nBuildingsSolar: p.n_buildings_solar ?? 0,
          sumKwpInstalled: p.sum_kwp_installed ?? 0,
          tier: p.tier ?? "early",
        };
      }
    }
    return null;
  }

  async function perBuildingDetectionsByOsmId(): Promise<Map<number, PerBuildingDetection[]>> {
    const fc = await loadJson("/data/per_building_solar_ncr.geojson");
    const out = new Map<number, PerBuildingDetection[]>();
    if (!fc?.features) return out;
    for (const f of fc.features) {
      const p = f.properties ?? {};
      const osmId = typeof p.building_osm_id === "number" ? p.building_osm_id : null;
      if (osmId === null) continue;
      const polygon = (f.geometry?.coordinates && f.geometry.coordinates[0]) || [];
      const rec: PerBuildingDetection = {
        osmId,
        panelAreaM2: typeof p.panel_area_m2 === "number" ? p.panel_area_m2 : 0,
        kwpEstimate: typeof p.kwp_estimate === "number" ? p.kwp_estimate : 0,
        confidence: typeof p.confidence === "number" ? p.confidence : 0,
        tile_id: p.tile_id ?? "",
        panelPolygon: polygon,
      };
      const list = out.get(osmId);
      if (list) {
        list.push(rec);
      } else {
        out.set(osmId, [rec]);
      }
    }
    return out;
  }

  async function neighborhoodContext(point: [number, number]) {
    // All independent loads in one parallel batch, no waterfall. The franchise
    // polygons and city counts used to be awaited sequentially after this.
    const [caseDoc, manifest, detections, perBuildingMap, saturation, cities, counts] = await Promise.all([
      loadJson("/data/case_studies.json"),
      loadJson("/data/manifest.json"),
      nearbyDetections(point, 1.5),
      perBuildingDetectionsByOsmId(),
      saturationCellAt(point[0], point[1]),
      loadJson("/data/franchise_cities_polygons.geojson"),
      loadJson("/data/city_detection_counts.json"),
    ]);
    const cases: CaseStudy[] = caseDoc?.cases ?? [];
    const enriched = cases.map((c) => ({
      ...c,
      distanceKm: distance(
        { type: "Point", coordinates: point } as any,
        { type: "Point", coordinates: [c.lon, c.lat] } as any,
        { units: "kilometers" } as any
      ),
    }));
    enriched.sort((a, b) => a.distanceKm - b.distanceKm);
    let cityComposite: {
      city: string;
      nHigh: number;
      nNewHigh: number;
      nCandidate: number;
      densityRank: number;
      densityTotal: number;
    } | null = null;
    let cityProvince: string | null = null;
    // Use the franchise polygons to find the city the address falls inside,
    // then look up detection counts from the clf_v4 survey.
    if (cities?.features && counts?.rows) {
      const containing = cities.features.find((f: any) => {
        const polys = f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates;
        return polys.some((poly: number[][][]) => booleanPointInPolygon({ type: "Point", coordinates: point } as any, { type: "Feature", geometry: { type: "Polygon", coordinates: poly } } as any));
      });
      if (containing) {
        const cityName = containing.properties.name;
        cityProvince = containing.properties.province ?? null;
        const row = counts.rows.find((r: any) => r.name === cityName);
        const sortedDensity = [...counts.rows].filter((r: any) => r.high_per_km2 > 0).sort((a: any, b: any) => b.high_per_km2 - a.high_per_km2);
        const densityRank = row ? sortedDensity.findIndex((r: any) => r.name === cityName) + 1 : 0;
        cityComposite = {
          city: cityName,
          nHigh: row?.n_high ?? 0,
          nNewHigh: row?.n_new_high ?? 0,
          nCandidate: row?.n_candidate ?? 0,
          densityRank: densityRank > 0 ? densityRank : 0,
          densityTotal: sortedDensity.length,
        };
      }
    }
    return { nearestCases: enriched.slice(0, 3), cityComposite, cityProvince, detections, perBuildingMap, saturation };
  }

  type LguInfo = {
    fee: number | null;
    days: number | null;
    status: string;
    notes: string;
    doe: { permit_target_days: number; cfei_target_days: number; deemed_approved: boolean } | null;
    feeRange: { low: number; high: number } | null;
  };

  async function lguPermit(cityName: string | null, province: string | null): Promise<LguInfo> {
    const data = await loadJson("/data/lgu_friction.json");
    const doe = data?._doe_circular_2026
      ? {
          permit_target_days: data._doe_circular_2026.permit_target_days,
          cfei_target_days: data._doe_circular_2026.cfei_target_days,
          deemed_approved: !!data._doe_circular_2026.deemed_approved,
        }
      : null;
    // Observed fee range from the verified province-level references (commercial
    // project comparisons, shown as honest context, never as a personal quote).
    let feeRange: { low: number; high: number } | null = null;
    if (data?.verified) {
      const fees = Object.values(data.verified)
        .map((v: any) => v.permit_fee_php)
        .filter((n: any) => typeof n === "number");
      if (fees.length) feeRange = { low: Math.min(...fees), high: Math.max(...fees) };
    }
    // Exact verified city match (rare in v1).
    if (data?.verified && cityName && data.verified[cityName]) {
      const v = data.verified[cityName];
      return { fee: v.permit_fee_php, days: v.permit_days_p50, status: "verified", notes: v.notes ?? "", doe, feeRange };
    }
    return {
      fee: null,
      days: doe?.permit_target_days ?? null,
      status: "doe-baseline",
      notes: province ? `Province-level reference for ${province}.` : "",
      doe,
      feeRange,
    };
  }

  function aspectRatioOf(building: Building): number {
    const dLon = building.bboxM.maxLon - building.bboxM.minLon;
    const dLat = building.bboxM.maxLat - building.bboxM.minLat;
    const cLat = (building.bboxM.minLat + building.bboxM.maxLat) / 2;
    const widthM = dLon * 111000 * Math.cos((cLat * Math.PI) / 180);
    const heightM = dLat * 111000;
    return Math.max(widthM, heightM) / Math.max(0.1, Math.min(widthM, heightM));
  }

  // Decision tree for the headline verdict. Order matters: earlier checks
  // dominate later ones (e.g., "already has solar" wins over saturation tier).
  function computeVerdict(args: {
    building: Building;
    usableRoofM2: number;
    kwp: number;
    annualSavings: number;
    payback: number;
    detectedSolar: any | null;
    saturation: SaturationCell | null;
    cityComposite: any | null;
  }): Verdict {
    const { building, usableRoofM2, kwp, annualSavings, payback, detectedSolar, saturation, cityComposite } = args;

    const fmtPhp = (n: number) => "₱" + Math.round(n).toLocaleString();
    const fmtKwp = (n: number) => n.toFixed(1) + " kWp";
    const fmtYrs = (n: number) => Number.isFinite(n) ? n.toFixed(1) + " years" : "n/a";

    // Roof area thresholds: below 25 m² usable, residential solar doesn't pay back;
    // above 500 m² building area, you're outside homeowner solar territory and need
    // a commercial developer (net metering caps at NET_METERING_CAP_KW).
    const RES_AREA_FLOOR_M2 = 25;
    const RES_AREA_CEILING_M2 = 500;

    // 1) Already has solar, the highest-priority case. Don't quote NEW-install savings.
    if (detectedSolar && detectedSolar.n > 0) {
      return {
        kind: "already-has",
        tone: "info",
        headline: "Heads up: this building already has solar.",
        subhead: `Our satellite scan found ${detectedSolar.n} panel polygon${detectedSolar.n > 1 ? "s" : ""} on this OSM building, totaling roughly ${fmtKwp(detectedSolar.kwp)} installed. Top match confidence ${(detectedSolar.confidence * 100).toFixed(0)}%.`,
        bullets: [
          { kind: "size", text: `If this is your home, the savings estimate below is for a NEW install, not your current bill.` },
          { kind: "alert", text: `If this isn't yours, the satellite may be looking at a neighbor; OSM building outlines aren't always precise.` },
          { kind: "money", text: `Either way: register with Meralco's Net Metering Program if you haven't, otherwise surplus generation is wasted.` },
        ],
        nextSteps: [
          { label: "Why registration matters", href: "/safety#reg" },
        ],
      };
    }

    // 2) Building too large = commercial scale. Different math, different financing.
    if (building.areaM2 > RES_AREA_CEILING_M2) {
      return {
        kind: "commercial",
        tone: "info",
        headline: "This is a commercial-scale building.",
        subhead: `At ${Math.round(building.areaM2)} m², you're outside homeowner solar territory. You'd need a commercial solar developer, not a residential installer.`,
        bullets: [
          { kind: "size", text: `Maximum system would be ~${fmtKwp(kwp)}, which is PPA territory, not net metering.` },
          { kind: "money", text: `Net metering caps at ${NET_METERING_CAP_KW} kW. Above that you'd need a Power Purchase Agreement and DOE Renewable Energy registration.` },
          { kind: "alert", text: `Above 1 MW you'd also need an ERC interconnection study. Talk to a commercial developer.` },
        ],
        nextSteps: [
          { label: "Read the safety primer", href: "/safety" },
        ],
      };
    }

    // 3) Roof too small, so be honest, don't sell solar that won't pay back.
    if (usableRoofM2 < RES_AREA_FLOOR_M2) {
      return {
        kind: "too-small",
        tone: "stop",
        headline: "Probably not. This roof is too small for solar to pay back.",
        subhead: `Only ${Math.round(usableRoofM2)} m² of usable roof. Below ~25 m², the inverter cost alone makes the math hard.`,
        bullets: [
          { kind: "size", text: `Maximum system: ${fmtKwp(kwp)} (a typical PH home is 3-8 kWp).` },
          { kind: "money", text: `Best case: about ${fmtPhp(annualSavings)}/year saved, payback ${fmtYrs(payback)}.` },
          { kind: "alert", text: `Energy-efficient appliances or a small battery for outage backup may have better ROI for you.` },
        ],
        nextSteps: [
          { label: "Try another address" , href: "#roof-form" },
        ],
      };
    }

    // 4) Outside Meralco franchise: solar still works but rules differ.
    if (!cityComposite) {
      return {
        kind: "outside-franchise",
        tone: "go",
        headline: `Yes, but you're outside Meralco's franchise.`,
        subhead: `Solar still works at this address. The rules belong to your local electric cooperative, not Meralco. Net-metering process and rates differ.`,
        bullets: [
          { kind: "size", text: `Roof can fit a ${fmtKwp(kwp)} system on ${Math.round(usableRoofM2)} m² of usable roof.` },
          { kind: "money", text: `At Meralco-equivalent rates: ~${fmtPhp(annualSavings)}/year saved, payback ${fmtYrs(payback)}. Local rates are likely lower; payback may take longer.` },
          { kind: "neighborhood", text: `Confirm net-metering rules with your local coop before signing with an installer.` },
        ],
        nextSteps: [
          { label: "Safe installation checklist", href: "/safety#checklist" },
        ],
      };
    }

    // 5-7) Tier-based variants for franchise-area roofs that pass the size gate.
    const tier = saturation?.tier ?? "early";
    const moneyText = `Save ~${fmtPhp(annualSavings)}/year, payback in ${fmtYrs(payback)} (${fmtKwp(kwp)} system).`;
    const sizeText = `${Math.round(usableRoofM2)} m² of usable roof, fits ${fmtKwp(kwp)}.`;

    if (tier === "saturated") {
      const nHigh = saturation?.nPanelsHigh ?? 0;
      const sumKwp = saturation?.sumKwpInstalled ?? 0;
      return {
        kind: "yes-saturated",
        tone: "caution",
        headline: "Yes, but request a hosting-capacity check before you size the system.",
        subhead: `Your block is solar-dense. Without a hosting-capacity check, your installer might oversize and your application could be downsized or delayed by Meralco engineering review.`,
        bullets: [
          { kind: "neighborhood", text: `${nHigh} confirmed install${nHigh === 1 ? "" : "s"} and ~${Math.round(sumKwp)} kWp already within 300m of you.` },
          { kind: "size", text: sizeText },
          { kind: "money", text: moneyText + " Skip the check, and the system you actually get approved may be smaller than this." },
        ],
        nextSteps: [
          { label: "Why this matters", href: "/safety#why" },
          { label: "Safe installation checklist", href: "/safety#checklist" },
        ],
      };
    }

    if (tier === "growing") {
      const nHigh = saturation?.nPanelsHigh ?? 0;
      const sumKwp = saturation?.sumKwpInstalled ?? 0;
      return {
        kind: "yes-normal",
        tone: "go",
        headline: `Yes. About ${fmtPhp(annualSavings)}/year saved, payback in ${fmtYrs(payback)}.`,
        subhead: `Your block is in the growing-adoption zone. Engineering review will look closely at your inverter datasheet and net-metering paperwork, but approval is normal.`,
        bullets: [
          { kind: "size", text: sizeText },
          { kind: "money", text: moneyText },
          { kind: "neighborhood", text: `${nHigh} confirmed install${nHigh === 1 ? "" : "s"} in 300m and ~${Math.round(sumKwp)} kWp installed. You'll be one of several reviewed this quarter.` },
        ],
        nextSteps: [
          { label: "Safe installation checklist", href: "/safety#checklist" },
        ],
      };
    }

    // early / pioneer
    const nHigh = saturation?.nPanelsHigh ?? 0;
    return {
      kind: "yes-pioneer",
      tone: "go",
      headline: `Yes, and you'd be one of the first in your block.`,
      subhead: `About ${fmtPhp(annualSavings)}/year saved, payback in ${fmtYrs(payback)}. Plenty of headroom on the local distribution transformer; approval should be straightforward.`,
      bullets: [
        { kind: "size", text: sizeText },
        { kind: "money", text: moneyText },
        { kind: "neighborhood", text: nHigh === 0 ? "No confirmed solar installs visible within 300m of you. You'd be a pioneer." : `Only ${nHigh} confirmed install${nHigh === 1 ? "" : "s"} within 300m. You'd be among the first.` },
      ],
      nextSteps: [
        { label: "Safe installation checklist", href: "/safety#checklist" },
      ],
    };
  }

  async function run(opts: { address: string; bill: number; residents: string; presetGeo?: LatLon }) {
    const status = document.getElementById("roof-status")!;
    status.textContent = "Finding your address...";
    // Geolocation or autocomplete picks supply lat/lon directly; otherwise geocode.
    let geo: LatLon | null;
    if (opts.presetGeo) {
      geo = opts.presetGeo;
    } else if (acPicked) {
      geo = { lat: acPicked.lat, lon: acPicked.lon, display_name: addrInput.value };
    } else {
      geo = await geocode(opts.address);
    }
    if (!geo) {
      status.textContent = "Couldn't find that address. Try a chip below the field, or type a nearby landmark and pick from the dropdown.";
      return;
    }
    status.textContent = "Looking for your building from OpenStreetMap...";
    const buildings = await fetchBuildings(geo.lat, geo.lon, 80);
    if (!buildings.length) {
      // Try wider radius
      const wider = await fetchBuildings(geo.lat, geo.lon, 200);
      if (!wider.length) {
        status.textContent = "No building footprints near that address in OSM. Tip: try a more specific street name or a nearby landmark.";
        return;
      }
      buildings.push(...wider);
    }
    const building = pickBuilding([geo.lon, geo.lat], buildings);
    if (!building) {
      status.textContent = "Couldn't pick a single building. Try a more specific address.";
      return;
    }
    status.textContent = "Measuring your roof and pulling satellite imagery...";

    const bbox = paddedBbox(building, 50);
    const sizePx = 600;
    const imgUrl = esriExportUrl(bbox, sizePx);
    // Fallback: wider zoom (more padding), a different Esri cache region, often
    // succeeds when the tighter bbox returns blank.
    const imgUrlFallback = esriExportUrl(paddedBbox(building, 200), sizePx);
    const polygonPath = projectToImage(building.coords, bbox, sizePx);

    status.textContent = "Running solar math...";
    const aspectR = aspectRatioOf(building);
    const score = roofScore({ areaM2: building.areaM2, lat: geo.lat, aspectRatio: aspectR });
    const band = bandFromScore(score.score);

    // Use 80% of roof for panels (gaps between rows, walkable space, gutters)
    const usableRoofM2 = building.areaM2 * 0.8;
    const kwp = Math.round(usableRoofM2 * KWP_PER_M2 * 10) / 10;
    const annualKwh = estimateAnnualKwh(geo.lat, kwp);
    const annualSavings = annualKwh * MERALCO_RATE_PHP_PER_KWH;
    const installCost = kwp * INSTALL_COST_PHP_PER_KWP;
    const payback = paybackYears(installCost, annualSavings);
    const npv = lifetimeNpv(annualKwh, MERALCO_RATE_PHP_PER_KWH, installCost);
    const monthlyKwh = (opts.bill || 0) / MERALCO_RATE_PHP_PER_KWH;
    const offsetPct = monthlyKwh > 0 ? Math.min(1, annualKwh / 12 / monthlyKwh) : 0;
    const peerRange = TYPICAL_KWH_BY_RESIDENTS[opts.residents] ?? [240, 480];
    const peerLow = peerRange[0];
    const peerHigh = peerRange[1];
    const userPercentile =
      monthlyKwh < peerLow ? "below typical"
      : monthlyKwh > peerHigh ? "above typical"
      : "typical";

    status.textContent = "Looking up your neighborhood and LGU...";
    const ctx = await neighborhoodContext([geo.lon, geo.lat]);
    const lgu = await lguPermit(ctx.cityComposite?.city ?? null, ctx.cityProvince);

    // Per-building solar match: did our v2.1 panel-segmentation pipeline place
    // a panel polygon on THIS building?
    const buildingPanels = ctx.perBuildingMap.get(building.osmId) ?? [];
    const totalPanelM2 = buildingPanels.reduce((s, p) => s + p.panelAreaM2, 0);
    const totalKwpDetected = buildingPanels.reduce((s, p) => s + p.kwpEstimate, 0);
    const maxConf = buildingPanels.reduce((m, p) => Math.max(m, p.confidence), 0);
    const detectedSolar = buildingPanels.length > 0
      ? {
          n: buildingPanels.length,
          panelAreaM2: totalPanelM2,
          kwp: totalKwpDetected,
          confidence: maxConf,
          tileId: buildingPanels[0]?.tile_id ?? "",
          // Center the thumbnail on the building, not on the panel polygon corner.
          // building.center is the OSM polygon centroid (turf.centroid).
          tileLat: building.center[1],
          tileLon: building.center[0],
        }
      : null;

    // Build context warnings. Only warn when the matched footprint is at a
    // scale that produces unrealistic residential numbers. Building-type
    // tags alone (e.g. "school" tagged on a small classroom building) over-
    // warn and confuse users on perfectly fine residential queries.
    const warnings: { kind: "info" | "warn"; text: string }[] = [];
    if (building.areaM2 > RESIDENTIAL_AREA_CEILING_M2) {
      warnings.push({
        kind: "warn",
        text: building.isCommercial
          ? `We matched a <strong>${building.buildingType}</strong> (${Math.round(building.areaM2)} m²) at this address. The numbers below are at THAT building's scale, not a typical home. For your own house, type your specific street name and number.`
          : `The matched building is unusually large (${Math.round(building.areaM2)} m²). If this isn't your home, try a more specific street and number.`,
      });
    }
    if (!ctx.cityComposite) {
      warnings.push({
        kind: "info",
        text: `Outside Meralco's franchise, so neighborhood and LGU permit data won't appear. The roof score and savings estimate still apply (we use the same PH yield baseline).`,
      });
    }

    // Compute the headline verdict: a binary "can I install solar here?" answer
    // grounded in roof size, neighborhood saturation, existing detected solar,
    // building scale, and franchise status. The verdict folds these signals
    // into one decisive answer so the user doesn't have to integrate a roof
    // score, a saturation tier, and a payback number on their own.
    const verdict = computeVerdict({
      building,
      usableRoofM2,
      kwp,
      annualSavings,
      payback,
      detectedSolar,
      saturation: ctx.saturation,
      cityComposite: ctx.cityComposite,
    });

    status.textContent = "";
    render({
      address: geo.display_name,
      lat: geo.lat,
      lon: geo.lon,
      building,
      imgUrl,
      imgUrlFallback,
      polygonPath,
      sizePx,
      score: score.score,
      breakdown: score.breakdown,
      band,
      kwp,
      annualKwh,
      annualSavings,
      installCost,
      payback,
      npv,
      monthlyBill: opts.bill,
      monthlyKwh,
      offsetPct,
      peerLow,
      peerHigh,
      userPercentile,
      cases: ctx.nearestCases,
      detections: ctx.detections,
      cityComposite: ctx.cityComposite,
      lgu,
      warnings,
      detectedSolar,
      saturation: ctx.saturation,
      verdict,
    });
  }

  function esriThumbUrl(lat: number, lon: number, sizePx = 300): string {
    const half = 0.0011; // ~120m at lat 14.6 -> ~240m view, matches the scan tile
    const bbox = `${lon - half},${lat - half},${lon + half},${lat + half}`;
    const params = new URLSearchParams({
      bbox,
      bboxSR: "4326",
      size: `${sizePx},${sizePx}`,
      imageSR: "3857",
      format: "jpg",
      f: "image",
    });
    return `https://services.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/export?${params}`;
  }

  function render(r: any) {
    const root = document.getElementById("roof-results")!;
    root.classList.remove("hidden");
    const warningsHtml = (r.warnings || [])
      .map((w: any) => {
        const tone = w.kind === "warn"
          ? "border-l-4 border-accent-coral bg-accent-coral/5"
          : "border-l-4 border-accent-steel bg-accent-steel/5";
        return `<div class="${tone} px-4 py-3 mb-3 text-sm text-ink-700 leading-relaxed">${w.text}</div>`;
      })
      .join("");
    const cases = (r.cases || []).map((c: any) => `
      <a href="/map?city=${encodeURIComponent(c.city.toLowerCase().replace(/[^a-z0-9]+/g, "-"))}" class="block group no-underline">
        <div class="aspect-square overflow-hidden bg-ink-300/10">
          <img src="${c.image_path}" alt="confirmed solar in ${c.city}" class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
        </div>
        <p class="text-xs text-ink-700 mt-1 leading-tight">${c.city}</p>
        <p class="text-[10px] text-ink-500 font-mono">${c.distanceKm.toFixed(1)} km away</p>
      </a>
    `).join("");

    // Hero verdict: the first thing the user sees. Replaces score-first framing.
    const v = r.verdict as Verdict;
