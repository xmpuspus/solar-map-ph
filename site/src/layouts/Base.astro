---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  image?: string;
}

const SITE_URL = "https://solarmap.ph";
const DEFAULT_IMAGE = "/og-preview.png";

const {
  title,
  description = "A computer-vision survey of rooftop solar across Greater Metro Manila, paired with a homeowner tool that sizes your own roof against current electricity rates and local permit costs.",
  pathname = Astro.url.pathname,
  image = DEFAULT_IMAGE,
} = Astro.props;

const canonical = `${SITE_URL}${pathname}`;
const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#10151c" />

    <!-- Runs before first paint so a reader who picked a theme never sees the
         other one flash. No stored choice means the system preference wins. -->
    <script is:inline>
      (function () {
        // .js gates every JS-dependent visual state, so nothing is hidden when
        // scripts are off or blocked.
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("solarmap-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>

    <meta property="og:site_name" content="SolarMap.PH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SolarMap.PH map of detected rooftop solar across Greater Metro Manila" />
    <meta property="og:locale" content="en_PH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SolarMap.PH map of detected rooftop solar across Greater Metro Manila" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": `${SITE_URL}/#website`,
            url: SITE_URL,
            name: "SolarMap.PH",
            description:
              "A computer-vision survey of rooftop solar across Greater Metro Manila, paired with a free homeowner tool that sizes your own roof against current electricity rates and local permit costs.",
            inLanguage: "en-PH",
          },
          {
            "@type": "WebApplication",
            "@id": `${SITE_URL}/#app`,
            url: SITE_URL,
            name: "SolarMap.PH roof tool",
            applicationCategory: "UtilitiesApplication",
            operatingSystem: "Web",
            browserRequirements: "Requires JavaScript.",
            description:
              "Type your address and get a satellite measurement of your roof, system size in kWp, payback in years, and detected rooftop solar near you. Free, no signup, runs entirely in your browser.",
            isAccessibleForFree: true,
            offers: { "@type": "Offer", price: "0", priceCurrency: "PHP" },
          },
          {
            "@type": "Dataset",
            "@id": `${SITE_URL}/#dataset`,
            name: "SolarMap.PH rooftop solar detections (Greater Metro Manila)",
            description:
              "Computer-vision detections of rooftop solar from public satellite imagery across Greater Metro Manila franchise cities, with per-building panel polygons and density aggregates.",
            license: "https://creativecommons.org/licenses/by/4.0/",
            creator: { "@type": "Organization", name: "SolarMap.PH" },
            url: `${SITE_URL}/map`,
            isAccessibleForFree: true,
          },
        ],
      })}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header pathname={pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal at MOTION_INTENSITY 3. Opacity and transform only, and
      // one IntersectionObserver rather than a scroll listener. The hidden
      // state lives under .js in global.css, which the head script sets, so
      // scripts off means nothing is hidden.
      const targets = document.querySelectorAll<HTMLElement>(".reveal");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        for (const el of targets) el.classList.add("is-in");
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        for (const el of targets) io.observe(el);
      }
    </script>
  </body>
</html>
