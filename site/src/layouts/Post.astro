---
import Base from "./Base.astro";

interface Frontmatter {
  title?: string;
  pubDate?: string | Date;
  status?: string;
  description?: string;
}

const { frontmatter } = Astro.props as { frontmatter?: Frontmatter };
const title = frontmatter?.title ?? "ghost-watts";
const description = frontmatter?.description;
const pubDate = frontmatter?.pubDate
  ? typeof frontmatter.pubDate === "string"
    ? frontmatter.pubDate
    : new Date(frontmatter.pubDate).toISOString().slice(0, 10)
  : null;
const status = frontmatter?.status;
---
<Base title={title} description={description}>
  <article class="max-w-prose mx-auto px-6 pt-8 pb-16">
    {status === "draft" ? (
      <div class="border-l-2 border-accent-coral bg-accent-coral/5 px-4 py-3 mb-6 text-sm">
        <p class="font-semibold text-accent-coral mb-1">Draft post · headline numbers pending</p>
        <p class="text-ink-700 text-xs leading-relaxed">This post was written as a structural template for the inaugural quarterly release. The TBD placeholders below get filled in once the first real Earth Engine pipeline run is reviewed. Until then, treat this as scaffolding, not findings.</p>
      </div>
    ) : null}
    {pubDate || (status && status !== "draft") ? (
      <p class="text-xs text-ink-500 mb-6 flex items-center gap-3">
        {pubDate && <span class="font-mono">{pubDate}</span>}
        {status && status !== "draft" && <span class="badge">{status}</span>}
      </p>
    ) : pubDate ? null : null}
    {pubDate && status === "draft" ? (
      <p class="text-xs text-ink-500 mb-6 font-mono">{pubDate}</p>
    ) : null}
    <div class="prose-content text-ink-900">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .prose-content h1 {
    @apply text-3xl font-semibold tracking-tight mt-2 mb-4;
  }
  .prose-content h2 {
    @apply text-2xl font-semibold tracking-tight mt-8 mb-3;
  }
  .prose-content h3 {
    @apply text-lg font-semibold tracking-tight mt-6 mb-2;
  }
  .prose-content p {
    @apply text-base leading-relaxed mb-4 text-ink-900;
  }
  .prose-content ul {
    @apply list-disc pl-5 mb-4 space-y-1.5 text-base text-ink-900;
  }
  .prose-content ol {
    @apply list-decimal pl-5 mb-4 space-y-1.5 text-base text-ink-900;
  }
  .prose-content li {
    @apply leading-relaxed;
  }
  .prose-content a {
    @apply text-accent-steel no-underline hover:text-ink-900 hover:underline;
  }
  .prose-content code {
    @apply bg-ink-300/15 px-1.5 py-0.5 rounded text-[0.92em] font-mono;
  }
  .prose-content blockquote {
    @apply border-l-4 border-ink-300 pl-4 italic text-ink-700 my-4;
  }
  .prose-content strong {
    @apply font-semibold text-ink-900;
  }
  .prose-content hr {
    @apply my-8 border-ink-300/40;
  }
  .prose-content table {
    @apply w-full text-sm border-collapse my-6;
  }
  .prose-content th {
    @apply text-left font-semibold border-b border-ink-300 pb-2;
  }
  .prose-content td {
    @apply py-2 border-b border-ink-300/30;
  }
</style>
